#!/usr/bin/python3 -I
"""exc-guard — fail-closed shell-hook tartalék a `hooks.pre_tool_call`-hoz (#775, H-4, P5).

Külön processz. Minden művelet előtt friss, szerveroldali policyból dönt.
Ha a szerver nem érhető el, Kötött pálya érvényes; a user írható cache-e nem ad engedélyt.
Ha ez a program elszáll, a Hermes
(`fail_closed: true`) blokkolja a toolt. Az allow üres JSON, mert a nem-JSON
stdoutot a fail_closed szintén blokkolná.
"""
import json
import os
import sys


def user_can_change(path):
    """Az aktuális user módosíthatja vagy törölheti-e a fájlt."""
    if os.name != "nt":
        info = os.stat(path)
        return info.st_uid != 0 or bool(info.st_mode & 0o022)
    # Windowson az st_uid mindig 0: a tényleges ACL-t kérdezzük meg egy írási megnyitással,
    # ami a tartalmat nem módosítja. A könyvtárban a fájl cseréje is módosítás.
    import ctypes
    from ctypes import wintypes
    create = ctypes.WinDLL("kernel32", use_last_error=True).CreateFileW
    create.restype = wintypes.HANDLE
    create.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, wintypes.LPVOID, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
    close = ctypes.windll.kernel32.CloseHandle
    share, open_existing, backup_semantics = 7, 3, 0x02000000
    checks = (
        (path, 0x40000000 | 0x00010000, 0),  # GENERIC_WRITE | DELETE
        (os.path.dirname(path), 0x2 | 0x40, backup_semantics),  # FILE_ADD_FILE | FILE_DELETE_CHILD
    )
    for target, access, flags in checks:
        handle = create(target, access, share, None, open_existing, flags, None)
        if handle not in (None, wintypes.HANDLE(-1).value):
            close(handle)
            return True
    if not os.path.isfile(path):
        raise FileNotFoundError(path)
    return False


def managed_gateway_url(managed_dir):
    path = os.path.join(managed_dir, "config.yaml")
    if user_can_change(path):
        raise ValueError("A céges konfiguráció rendszergazdai tulajdont és írásvédelmet igényel")
    with open(path, encoding="utf-8") as fh:
        in_model = False
        for line in fh:
            if line.strip() and not line.startswith((" ", "#")):
                in_model = line.strip() == "model:"
            if in_model and line.startswith("  base_url:"):
                return json.loads(line.split(":", 1)[1].strip())
    raise ValueError("Hiányzó céges modell-útvonal")


def plugin_dir():
    here = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.path.join(here, "excellence-guard"),
        "/opt/excellence/hermes-plugins/excellence-guard",
        r"C:\ProgramData\Excellence\hermes-plugins\excellence-guard",
    ]
    for path in candidates:
        if os.path.isfile(os.path.join(path, "policy.py")):
            return path
    return None


def main():
    directory = plugin_dir()
    if not directory:
        sys.stderr.write("Az exc-guard nem találja a céges szabálymodult, ezért nem engedek műveletet.\n")
        return 2
    sys.path.insert(0, directory)
    import policy
    import runtime

    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        sys.stderr.write("A céges ellenőrzés nem tudta elolvasni a kérést, ezért nem engedem.\n")
        return 2
    if not isinstance(payload, dict):
        payload = {}
    tool = payload.get("tool_name") or ""
    args = payload.get("tool_input") if isinstance(payload.get("tool_input"), dict) else {}
    home = os.environ.get("HERMES_HOME") or runtime.default_home()
    try:
        token_helper = runtime.load_exc_token()
        origin = token_helper.read_profile(home)[0] if token_helper else None
        expected = origin + "/api/model-gateway/v1" if origin else None
        if not policy.is_excellence_route("excellence", managed_gateway_url(runtime.DEFAULT_MANAGED_DIR), expected):
            raise ValueError("A profil nem a céges modell-útvonalhoz tartozik")
        status, snapshot = runtime.fetch_snapshot(home)
    except Exception:
        status, snapshot = "down", None
    interpreted = {"kind": "snapshot", "snapshot": snapshot} if status == "ok" else {"kind": "revoked" if status == "revoked" else "bound"}
    decision = policy.decide_interpreted(interpreted, tool, args)
    sys.stdout.write(json.dumps(policy.hook_body(decision), ensure_ascii=False) + "\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.stderr.write("A céges ellenőrzés hibázott, ezért ezt a műveletet nem engedem.\n")
        sys.exit(2)
