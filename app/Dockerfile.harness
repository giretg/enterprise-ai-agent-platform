# Harness image — platform completion entrypoint (§5.6, §6).
# A konténer nem futtat saját agent-loopot: `HARNESS_MODE=wiki` mellett a
# platform `/api/v1/harness/tickets/{id}/process` végpontját hívja, és a
# completion-callbackkel zár. Provider-független.
FROM node:20-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

COPY . .

ENV NODE_ENV=production
ENV HARNESS_MODE=wiki

CMD ["npm", "run", "harness:run"]
