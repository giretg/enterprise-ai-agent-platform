# Dedikált dispatch-ciklus worker image (#114) — Cloud Run SERVICE.
#
# Ezt hívja a Cloud Scheduler a control-plane UI HELYETT: ugyanaz a végpont
# (`POST /api/v1/internal/dispatch-cycle`), ugyanaz a `runDispatchCycle` mag, csak külön
# konténerben és külön CPU/memória profillal — így egy nehéz ciklus nem lassítja/OOM-olja
# az interaktív oldalakat, és a két terhelés metrikái sem keverednek.
#
# NEM azonos a `Dockerfile.dispatcher` image-dzsel: az a legacy wiki-harness LISTEN/NOTIFY
# worker (állandó Neon-kapcsolat, min-instances=1). Ez itt stateless: kérésre ébred,
# lefuttat egy kört, és visszaskálázódhat.
#
# Goose/harness NINCS benne — ez csak a ciklust futtatja; az agent-futtatás továbbra is a
# wiki-harness Cloud Run Job dolga.
FROM node:20-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY prisma ./prisma
# A postinstall (prisma generate) itt fut le; a devDependencies (tsx) kell a belépőhöz.
RUN npm ci

COPY . .

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

# Stateless HTTP szerver: POST /api/v1/internal/dispatch-cycle + GET /healthz.
CMD ["npm", "run", "dispatch-cycle:server"]
