# next.js
/.next/
/.next-local-auth/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# GCP harness job config (contains secrets) — keep only the .example
infra/gcp/harness-job.env
infra/gcp/dispatcher-service.env
infra/gcp/dispatch-cycle-scheduler.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/uploads
/.data
.seed-demo-api-key
/.connector-grants
/.connector-secrets

# Generated measurement reports (§9.1/7 — npm run report:measurement)
/reports
