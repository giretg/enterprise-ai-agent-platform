FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY scripts/code-sandbox-server.ts ./scripts/code-sandbox-server.ts
ENV NODE_ENV=production PORT=8080
CMD ["node", "--import", "tsx", "scripts/code-sandbox-server.ts"]
