  promoted
  rejected
  rolled_back
}

enum SandboxSnapshotKind {
  manual
  pre_promotion
  scheduled
  pre_rollback
}

enum SandboxSnapshotStatus {
  creating
  available
  restoring
  expired
  failed
}

enum SandboxExportStatus {
  requested
  building
  ready
  delivered
  failed
}

enum SandboxExportScope {
  code_only
  code_and_schema
  full
}

enum SandboxActorType {
  user
  agent
  system
}

model SandboxProject {
