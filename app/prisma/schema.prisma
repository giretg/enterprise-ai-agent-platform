generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  approver
  operator
  viewer
}

enum UserStatus {
  pending
  active
  suspended
}

enum InvitationStatus {
  pending
  redeemed
  expired
  revoked
}

// ── Tenant Management (Feature-spec Tenant-Management §4) ────────────────────

enum TenantStatus {
  active
  suspended
  offboarding
  archived
}

enum TenantMembershipStatus {
  pending
  active
  suspended
}

/**
 * Platform-szintű szerep — NEM tenant-role (§3.1). Az enum bővíthetően
 * vezeti be a platform-szerepeket (§6.2, döntés 3.3/10).
 */
enum PlatformRole {
  superadmin
  platform_operator
  platform_auditor
}

enum PlatformMembershipStatus {
  active
  suspended
}

enum ResourceGrantType {
  agent
  playbook
  ticket_type
}

enum ResourceAccessLevel {
  view
  operate
  approve
}

enum AgentStatus {
  draft
  active
  suspended
  retired
}

enum AgentRole {
  worker
  orchestrator
}

/// Agent-hozzáférési gráf (Access-Policy §agent-scope): az él ALANYA vagy egy konkrét
/// user, vagy egy másik agent. Csoport/Team/OrgUnit alany szándékosan NEM tartozik ide —
/// az külön domain-entitást és migrációt igényelne.
enum AgentAccessSubjectType {
  user
  agent

  @@map("agent_access_subject_type")
}

/// Konfigurálható szerep-sablon (Feature-spec §3.5) — a szerep ADAT-konfiguráció,
/// nem beégetett típus. A `tool_access_allowed` runtime-invariánst a Tool Broker
/// `authorize()` elsőként nézi (§6); orchestrator = FALSE (tool-less by design).
/// `tenant_id = NULL` → rendszer-szintű beépített sablon (worker | orchestrator).
model RoleTemplate {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String?   @map("tenant_id") @db.Uuid
  key                  AgentRole
  displayName          String    @map("display_name")
  toolAccessAllowed    Boolean   @map("tool_access_allowed")
  // worker: tetszőleges capability (["*"]); orchestrator: kizárólag ["ticket:create"].
  allowedOutbound      Json      @map("allowed_outbound")
  // Az orchestrator is a write-gate alatt áll (nincs kivételezett státusz).
  selfEvolutionAllowed Boolean   @map("self_evolution_allowed")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, key])
  @@map("role_templates")
}

enum PlaybookVersionStatus {
  proposed
  active
  retired
}

enum ApiKeyStatus {
  active
  revoked
}

enum MemoryVersionStatus {
  proposed
  active
  rolled_back
}

enum ResourceType {
  secret
  policy
  file
  dataset
  connector
  tool
}

enum ResourceScope {
  global
  group
  single
}

enum AccessMode {
  read
  use
}

enum ConnectorType {
  knowledge_base
  board
  gmail
  workspace
  http_api
  web_search
}

enum ConnectorAuthMode {
  service
  user_delegated
  agent_owned
}

enum ConnectorGrantStatus {
  active
  revoked
  expired
}

enum ConnectorScope {
  global
  single
}

enum ConnectorAccessMode {
  read
  write
}

// ── Fázis 2: Provisioning Assistant (Connector Onboarding) ──────────────────
// A connector életciklus-állapota. DEFAULT `active`, hogy a meglévő sorok
// viselkedése változatlan maradjon; a draft-connector `draft|validated`
// állapotban a Tool Brokerben SOHA nem oldódik fel (runtime DENY).
// (Feature-spec — Provisioning-Assistant §4.1.)
enum ConnectorLifecycleState {
  draft
  validated
  active
  archived
  blocked

  @@map("connector_lifecycle_state")
}

enum ConnectorDraftSourceType {
  api_doc
  openapi
  manual
  template

  @@map("connector_draft_source_type")
}

enum ConnectorTemplateOrigin {
  builtin
  custom

  @@map("connector_template_origin")
}

enum ConnectorTemplateStatus {
  active
  deprecated
  archived

  @@map("connector_template_status")
}

enum ConnectorDraftReviewStatus {
  pending
  changes_requested
  approved
  rejected

  @@map("connector_draft_review_status")
}

// ── Önfrissítő connector (Dev-Spec — Self-Updating-Connector §5) ────────────
// A connector "módja". DEFAULT `fixed`, hogy a meglévő sorok viselkedése
// változatlan maradjon; `self_updating` connector kap egy ConnectorSpecSource-ot
// és a futásidejű képességeit az `activeSpecVersion` capabilitySet-je adja (A3).
enum ConnectorMode {
  fixed
  self_updating

  @@map("connector_mode")
}

// Egy letöltött+parse-olt spec-pillanatkép életciklusa (Dev-Spec §5/§9).
// `proposed` a szinkron eredménye; emberi jóváhagyás → `approved` (ez lesz az aktív),
// a korábbi aktív → `superseded`; elutasítás → `rejected`; rollback → `rolled_back`.
enum ConnectorSpecVersionStatus {
  proposed
  approved
  superseded
  rejected
  rolled_back

  @@map("connector_spec_version_status")
}

enum ToolCallStatus {
  ok
  denied
  error
}

/// Következmény-kapu (issue #97) — külső tartalom után mellékhatásos tool
/// emberi jóváhagyásra vár. A teljes tool-args itt él (az argsMeta csak összefoglaló).
enum ConsequenceApprovalStatus {
  pending
  approved
  rejected
  expired

  @@map("consequence_approval_status")
}

// issue #97 — bizalmi osztály minden eszköz-eredményen. Determinisztikus,
// tool-nevenkénti besorolás (tool-trust-registry.ts); indexelt audit-oszlop.
enum TrustClass {
  trusted
  internal
  external_untrusted
}

enum ModelCallStatus {
  ok
  error
  rate_limited
}

