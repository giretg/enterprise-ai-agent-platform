/**
 * #942: egy knowledge_base connectorhoz egy élő wiki (D11).
 */
model AgentWiki {
  id                  String   @id @default(uuid()) @db.Uuid
  connectorId         String   @unique @map("connector_id") @db.Uuid
  /**
   * WIKI.md — csak ember szerkeszti (D15).
   */
  schemaMd            String   @map("schema_md") @db.Text
  lastLint            Json?    @map("last_lint")
  /**
   * #978 D6: a következő alkalmazott change-set sorszáma (sor-zár az alkalmazáskor).
   */
  nextSeq             Int      @default(1) @map("next_seq")
  /**
   * #978 D1: ennyi napig minden verzió megmarad.
   */
  retentionFullDays   Int      @default(90) @map("retention_full_days")
  /**
   * #978 D1: ennyi nap után a régi verziók törlődnek; null = soha.
   */
  retentionDeleteDays Int?     @default(365) @map("retention_delete_days")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  connector   Connector        @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  pages       WikiPage[]
  changeSets  WikiChangeSet[]
  logEntries  WikiLogEntry[]
  tags        WikiTag[]
  readCursors WikiReadCursor[]
  erasures    WikiErasure[]

  @@map("agent_wikis")
}

model WikiPage {
  id               String         @id @default(uuid()) @db.Uuid
