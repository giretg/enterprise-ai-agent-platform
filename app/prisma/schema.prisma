model Handoff {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  fromAgentId      String        @map("from_agent_id") @db.Uuid
  fromDefinitionId String        @map("from_definition_id") @db.Uuid
  toAgentId        String?       @map("to_agent_id") @db.Uuid
  toUserId         String?       @map("to_user_id") @db.Uuid
  projectKey       String        @map("project_key")
  title            String
  summary          String        @db.Text
  links            String?
  status           HandoffStatus @default(open)
  memoryId         String?       @map("memory_id") @db.Uuid
  createdById      String        @map("created_by_id") @db.Uuid
  decidedById      String?       @map("decided_by_id") @db.Uuid
  decidedAt        DateTime?     @map("decided_at") @db.Timestamptz
  // #940: a létrehozó MCP-kérés idempotencia-kulcsa. Ismételt (retry) hívás
  // ugyanazzal a kulccsal nem hoz létre duplikált átadást. NULL a kulcs nélküli
  // (pl. mini-app-megosztás) utakon — a Postgres a NULL-okat külön kezeli, így
  // nem ütköznek.
  idempotencyKey   String?       @map("idempotency_key")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  fromAgent Agent  @relation("HandoffFromAgent", fields: [fromAgentId], references: [id], onDelete: Cascade)
  toAgent   Agent? @relation("HandoffToAgent", fields: [toAgentId], references: [id], onDelete: Cascade)
  toUser    User?  @relation("HandoffToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  createdBy User   @relation("HandoffCreatedBy", fields: [createdById], references: [id])

  @@unique([tenantId, fromAgentId, idempotencyKey])
  @@index([tenantId, toAgentId, status])
  @@index([tenantId, toUserId, status])
  @@map("handoffs")
}

/// Hermes Managed Client policy (#746 V1-1): a tenant/user/agent szintű paraméterezés forrás-igazsága.
/// `scopeId` polimorf (tenant → tenantId, user → users.id, agent → agents.id), ezért nincs rá FK.
model ClientPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  scope         String
  scopeId       String   @map("scope_id") @db.Uuid
  preset        String?
  capabilities  Json     @default("{}")
  toolOverrides Json     @default("{}") @map("tool_overrides")
  version       Int      @default(1)
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, scopeId])
  @@map("client_policies")
}

/// Hermes Managed Client heartbeat-regiszter (#746 V1-7, R8): a Guard jelenléte és a gép állapota.
/// Egy user egy telepítése = egy sor; az `installId` kliens-oldali (a gateway-JWT-ben utazik), ezért a
/// kulcs a (tenant, user, installId) hármas — idegen user vagy tenant nem hivatkozhat rá.
model ClientInstall {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  installId       String   @map("install_id")
  lastHeartbeatAt DateTime @map("last_heartbeat_at") @db.Timestamptz
  configHash      String   @map("config_hash")
  managedDirHash  String   @map("managed_dir_hash")
  policyVersion   String   @map("policy_version")
  guardVersion    String   @map("guard_version")
  hermesVersion   String   @map("hermes_version")
  /// `hermes` = Guard heartbeat; `platform_chat` = szerveroldali platform-chat (#1004 WP-3), Guard-mezői üresek.
  kind            String   @default("hermes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions ClientInstallSession[]

  @@unique([tenantId, userId, installId])
  @@map("client_installs")
}

/// Platform-chat napi modell-költés (#1004 D14): tenantonként és budapesti naponként, a gateway írja.
model PlatformChatDailyUsage {
  tenantId  String   @map("tenant_id") @db.Uuid
  day       DateTime @db.Date
  costUsd   Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  calls     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, day])
  @@map("platform_chat_daily_usage")
}

/// A Guard által regisztrált Hermes-session; a Model Gateway csak ilyen sessionnek ad céges modellt.
model ClientInstallSession {
  id              String   @id @default(uuid()) @db.Uuid
  clientInstallId String   @map("client_install_id") @db.Uuid
  sessionId       String   @map("session_id")
  agentId         String   @map("agent_id") @db.Uuid
  lastSeenAt      DateTime @map("last_seen_at") @db.Timestamptz

  install ClientInstall @relation(fields: [clientInstallId], references: [id], onDelete: Cascade)

  @@unique([clientInstallId, sessionId, agentId], map: "client_install_sessions_client_install_id_session_id_agent__key")
  @@map("client_install_sessions")
}

/// A user gép-padlója (#771): stabil installId és a heartbeat által várt managed-dir hash.
/// Userenként egy (a gép a user legbővebb engedélyét követi; az eszközkötés #758).
model ClientMachineFloor {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  installId             String   @map("install_id")
  managedDirHash        String   @map("managed_dir_hash")
  /// A Windows-padló hash-e. A posix hash mellett él: egy munkatársnak lehet Macje és Windows-gépe is.
  windowsManagedDirHash String?  @map("windows_managed_dir_hash")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("client_machine_floors")
}

/// Model Gateway álnév-vault (#746 V1-4): `hermes_session` hatókörű e-mail/név → álnév leképezés.
/// Az érték AES-GCM-mel titkosított; a HMAC a sort köti a hatókörhöz (manipuláció-felismerés).
/// Fizikai törlés (retenció) a követő #747-ben.
model GatewaySurrogate {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  scopeType      String   @map("scope_type")
  scopeId        String   @map("scope_id")
  entityType     String   @map("entity_type")
  fingerprint    String
  surrogate      String
  hmac           String
  encryptedValue String   @map("encrypted_value")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scopeType, scopeId, entityType, fingerprint], map: "gateway_surrogates_scope_fingerprint_key")
  @@unique([tenantId, scopeType, scopeId, surrogate], map: "gateway_surrogates_scope_surrogate_key")
  @@index([createdAt])
  @@map("gateway_surrogates")
}

model CustomerPromise {
