  /**
   * Scope-kulcs (D-B): minden lekérdezés connectorra szűr.
   */
  connectorId      String         @map("connector_id") @db.Uuid
  path             String
  type             WikiPageType
  title            String
  summary          String
  category         String?
  frontmatter      Json           @default("{}")
  body             String         @db.Text
  /**
   * `[{ documentId, page?, section?, cell? }]`
   */
  sourceRefs       Json           @default("[]") @map("source_refs")
  outLinks         String[]       @default([]) @map("out_links")
  status           WikiPageStatus @default(published)
  version          Int            @default(1)
  contentHash      String         @map("content_hash")
  /**
   * D5: „más oldala" — archiválás/áthelyezés mindig jóváhagyással.
   */
  createdByAgentId String?        @map("created_by_agent_id") @db.Uuid
  createdByUserId  String?        @map("created_by_user_id") @db.Uuid
  updatedByAgentId String?        @map("updated_by_agent_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  wiki      AgentWiki          @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  connector Connector          @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  revisions WikiPageRevision[]

  @@unique([connectorId, path])
  @@index([wikiId, status])
  @@map("wiki_pages")
}

/**
 * Egy `kb_wiki_write` hívás — a jóváhagyás egysége (D1/D4).
 */
model WikiChangeSet {
  id                 String              @id @default(uuid()) @db.Uuid
  wikiId             String              @map("wiki_id") @db.Uuid
  connectorId        String              @map("connector_id") @db.Uuid
  agentId            String?             @map("agent_id") @db.Uuid
  userId             String?             @map("user_id") @db.Uuid
  status             WikiChangeSetStatus @default(pending)
  /**
   * Javasolt oldal-műveletek + `baseVersion`.
   */
  pages              Json                @default("[]")
  validation         Json?
  logEntry           Json?               @map("log_entry")
  sourceDocumentIds  String[]            @default([]) @map("source_document_ids")
  inboxItemId        String?             @map("inbox_item_id") @db.Uuid
  gatewayOperationId String?             @map("gateway_operation_id") @db.Uuid
  /**
   * D4: `{ kind: agent_owner | tenant_admin | owner_user, ... }`
   */
  approverScope      Json                @default("{}") @map("approver_scope")
  /**
   * #978 D6: alkalmazáskor, wikin belül növekvő; pending/rejected = null.
   */
  seq                Int?
  /**
   * #978 D5: ezt a change-setet vonja vissza.
   */
  revertsId          String?             @map("reverts_id") @db.Uuid
  /**
   * #978 D5: ez a change-set vonta vissza.
   */
  revertedById       String?             @map("reverted_by_id") @db.Uuid
  /**
   * #978 §6: alkalmazáskor számolt oldal-összefoglaló (útvonal, művelet, cím,
   * sorstatisztika) — a `pages` kiürítése után is megmarad.
   */
  pageSummary        Json?               @map("page_summary")
  /**
   * #978 §6: a `pages` JSON tartalma kiürítve (megőrzés vagy GDPR-törlés).
   */
  pagesPrunedAt      DateTime?           @map("pages_pruned_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  appliedAt          DateTime?           @map("applied_at") @db.Timestamptz

  wiki      AgentWiki          @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  connector Connector          @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  revisions WikiPageRevision[]

  @@unique([wikiId, seq])
  @@index([wikiId, status])
  @@map("wiki_change_sets")
}

model WikiPageRevision {
  id               String          @id @default(uuid()) @db.Uuid
  pageId           String          @map("page_id") @db.Uuid
  changeSetId      String?         @map("change_set_id") @db.Uuid
  version          Int
  title            String
  summary          String
  body             String          @db.Text
  frontmatter      Json            @default("{}")
  contentHash      String          @map("content_hash")
  /**
   * #978: a revízió teljes állapota (áthelyezés, archiválás, források visszaállításához).
   */
  path             String?
  status           WikiPageStatus?
  /**
   * NULL = a bevezetés előtti (backfill) revízió.
