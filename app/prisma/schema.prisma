  agentId    String       @map("agent_id") @db.Uuid
  keyHash    String       @map("key_hash")
  lookupHash String?      @unique @map("lookup_hash")
  scopes     Json
  status     ApiKeyStatus @default(active)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  rotatedAt  DateTime?    @map("rotated_at") @db.Timestamptz
  lastUsedAt DateTime?    @map("last_used_at") @db.Timestamptz
  expiresAt  DateTime?    @map("expires_at") @db.Timestamptz

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_api_keys")
}

model Memory {
  id               String  @id @default(uuid()) @db.Uuid
  currentVersionId String? @map("current_version_id") @db.Uuid

  agent           Agent?
  versions        MemoryVersion[]   @relation("MemoryVersions")
  currentVersion  MemoryVersion?    @relation("MemoryCurrentVersion", fields: [currentVersionId], references: [id])
  writeGateTokens WriteGateToken[]
  chunks          MemoryChunk[]     @relation("MemoryChunks")
  candidates      MemoryCandidate[] @relation("MemoryCandidates")

  @@map("memories")
}

model MemoryVersion {
  id               String              @id @default(uuid()) @db.Uuid
  memoryId         String              @map("memory_id") @db.Uuid
  version          Int
  // Legacy full-inject szövegblokk (§1.1). A tartós agent-memória spec
  // (agent-memory-persistent-cross-conversation-spec.md §9.3) óta a T2
  // kanonikus forrás a MemoryChunk; ez a mező demo-agenteken kívül NULL.
  content          String?
  diffFromPrevious Json?               @map("diff_from_previous")
  status           MemoryVersionStatus @default(proposed)
  source           String?
  approvedById     String?             @map("approved_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz

  // §9.3: a MemoryVersion mostani szerepe a T2 pillanatkép-manifeszt.
  activeChunkIds     Json?   @map("active_chunk_ids")
  changeSet          Json?   @map("change_set")
  projectKey         String? @map("project_key")
  workstreamKey      String? @map("workstream_key")
  sourceCandidateIds Json?   @map("source_candidate_ids")

  memory           Memory         @relation("MemoryVersions", fields: [memoryId], references: [id], onDelete: Cascade)
  approvedBy       User?          @relation("MemoryApprovedBy", fields: [approvedById], references: [id])
  agentVersions    AgentVersion[]
  currentForMemory Memory[]       @relation("MemoryCurrentVersion")
