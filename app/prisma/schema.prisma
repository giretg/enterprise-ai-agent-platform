  archived
}

// ── Csatorna-réteg (Telegram feature-spec #70, D14) ─────────────────────────
// Az általános Csatorna (Channel) réteg típus-diszkriminátora. Ma egyetlen tag
// (telegram); a WhatsApp/Slack/SMS adapterek KÍVÜL esnek a hatókörön (Out of Scope),
// de az enum és a séma előre felkészül rájuk.
enum ChannelType {
  telegram
}

/// A regisztrált csatorna-bot állapota. `disabled` esetén a csatorna némán zárva —
/// incidens esetén a platform-admin egy lépésben elzárhatja a kimenő/bejövő utat.
enum ChannelBotStatus {
  active
  disabled
}

/// A csatorna-identitás (külső fiók ↔ platform-felhasználó kötés) állapota.
/// `revoked` = a felhasználó/admin megszüntette; `blocked` = a külső oldal jelezte,
/// hogy a felhasználó letiltotta a botot (D15 — a küldés abbamarad). SZEREPKÖRT nem tárol.
enum ChannelIdentityStatus {
  active
  revoked
  blocked
}

/// A worker második munkatípusának (D8) sor-állapota. A forduló túléli a webhook-kérést,
/// újrapróbálható és mérhető.
enum ChannelTurnStatus {
  queued
  running
  done
  failed
}

enum MessageRole {
  user
  agent
  system
  tool
}

/// chat-agent-turn-resilience-spec.md §4 (D1) — a chat-agent-forduló életciklus-státusza.
/// A `queued|running|streaming` az aktív halmaz (l. az aktív-forduló invariánst),
/// a többi terminális.
enum AgentTurnStatus {
  queued
  running
  streaming
  completed
  exhausted
  cancelled
  failed
}

enum MessageCriticality {
  L0
  L1
  L2
  L3
}

enum RetentionPolicyAppliesTo {
  all
  agent
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  externalAuthId  String     @unique @map("external_auth_id")
  email           String
  name            String
  // Szabad szöveges "humán szerep" leírás (pl. "marketing vezető", "copywriter").
  // Az agent user_directory toolja ezt látja, hogy egy feladathoz megtalálja az illetékest.
  jobDescription  String?    @map("job_description")
  role            UserRole?
  status          UserStatus @default(pending) @map("status")
  tenantId        String?    @map("tenant_id") @db.Uuid
  invitedById     String?    @map("invited_by") @db.Uuid
  activatedAt     DateTime?  @map("activated_at") @db.Timestamptz
  suspendedAt     DateTime?  @map("suspended_at") @db.Timestamptz
  suspendedById   String?    @map("suspended_by") @db.Uuid
  suspendedReason String?    @map("suspended_reason")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  invitedBy                     User?                @relation("UserInvitedBy", fields: [invitedById], references: [id])
  invitedUsers                  User[]               @relation("UserInvitedBy")
  suspendedBy                   User?                @relation("UserSuspendedBy", fields: [suspendedById], references: [id])
  suspendedUsers                User[]               @relation("UserSuspendedBy")
  approvedMemoryVersions        MemoryVersion[]      @relation("MemoryApprovedBy")
  approvedRecipeVersions        RecipeVersion[]      @relation("RecipeApprovedBy")
  approvedSkillVersions         SkillVersion[]       @relation("SkillApprovedBy")
  approvedPlaybookVersions      PlaybookVersion[]    @relation("PlaybookApprovedBy")
  createdTickets                Ticket[]             @relation("TicketCreatedBy")
  ticketCommentsAuthored        TicketComment[]      @relation("TicketCommentAuthorUser")
  uploadedDocuments             Document[]           @relation("DocumentUploadedBy")
  createdInvitations            Invitation[]         @relation("InvitationCreatedBy")
  connectorGrants               ConnectorGrant[]
  scheduledTasksCreated         ScheduledTask[]      @relation("ScheduledTaskCreatedBy")
  scheduledTasksRunAs           ScheduledTask[]      @relation("ScheduledTaskRunAsUser")
  scheduledTasksRunAsAuthorized ScheduledTask[]      @relation("ScheduledTaskRunAsAuthorizedBy")
  monitorDefinitionsCreated     MonitorDefinition[]  @relation("MonitorDefinitionCreatedBy")
  conversationsCreated          Conversation[]       @relation("ConversationCreatedBy")
  messagesActing                Message[]            @relation("MessageActingUser")
  resourceGrantsReceived        ResourceGrant[]      @relation("ResourceGrantUser")
  resourceGrantsIssued          ResourceGrant[]      @relation("ResourceGrantGrantedBy")
  tenantMemberships             TenantMembership[]   @relation("MembershipUser")
  membershipsInvited            TenantMembership[]   @relation("MembershipInvitedBy")
  platformMemberships           PlatformMembership[] @relation("PlatformMembershipUser")
  tenantsCreated                Tenant[]             @relation("TenantCreatedBy")
  channelIdentities             ChannelIdentity[]    @relation("ChannelIdentityUser")
  channelLinkTokens             ChannelLinkToken[]   @relation("ChannelLinkTokenUser")
  userNotifications             UserNotification[]   @relation("UserNotificationUser")
  agentAccessGrantsAsSubject    AgentAccessGrant[]   @relation("AgentAccessSubjectUser")
  agentAccessGrantsIssued       AgentAccessGrant[]   @relation("AgentAccessGrantedBy")

  @@index([tenantId, status])
  @@index([tenantId, role])
  @@map("users")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String?          @map("tenant_id") @db.Uuid
  // A Clerk-meghívó visszavonásához és a provider/local állapot egyeztetéséhez.
  clerkInvitationId String?    @unique @map("clerk_invitation_id")
  email       String
  role        UserRole
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(pending)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz
  redeemedAt  DateTime?        @map("redeemed_at") @db.Timestamptz
  revokedAt   DateTime?        @map("revoked_at") @db.Timestamptz
  createdById String           @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  createdBy User @relation("InvitationCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, status])
  @@map("invitations")
}

/**
 * Tenant = egy cég/ügyfél első osztályú entitása (Feature-spec Tenant-Management §2, §4.1).
 * A tenant a by-design multi-tenancy izolációs egysége: két tenant nem osztozik
 * agenten, Playbookon, connectoron, sessionön vagy beálltáson (Koncepció 8.8).
 */
model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique
  displayName     String       @map("display_name")
  legalName       String?      @map("legal_name")
  status          TenantStatus @default(active)
  domainAllowlist Json         @default("[]") @map("domain_allowlist")
  settings        Json         @default("{}")
  createdById     String?      @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  createdBy         User?              @relation("TenantCreatedBy", fields: [createdById], references: [id])
  memberships       TenantMembership[]
  agentAccessGrants AgentAccessGrant[]

  @@index([status])
  @@map("tenants")
}

/**
 * Tenanton belüli szerep és státusz (§3.1, §4.1). A `User` a globális identitás,
 * a tenant-tagságot és -szerepet ez a join-modell hordozza — egy user több tenant
 * tagja is lehet (§2/3). Az igazság forrása membership-szinten van, nem a `User`-en.
 */
model TenantMembership {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  role        UserRole
  status      TenantMembershipStatus @default(pending)
  isDefault   Boolean                @default(false) @map("is_default")
  invitedById String?                @map("invited_by") @db.Uuid
  activatedAt DateTime?              @map("activated_at") @db.Timestamptz
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  user      User   @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("MembershipInvitedBy", fields: [invitedById], references: [id])

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, role, status])
  @@map("tenant_memberships")
}

/**
 * Platform-szintű tagság (§3.1, §4.1). A superadmin NEM tenant-role, ezért külön
 * modellben él — így a `hasMinimumRole(..., 'admin')` sosem tekinti tenant-adminnak.
 */
model PlatformMembership {
  id        String                   @id @default(uuid()) @db.Uuid
  userId    String                   @map("user_id") @db.Uuid
  role      PlatformRole
  status    PlatformMembershipStatus @default(active)
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation("PlatformMembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, status])
  @@map("platform_memberships")
}

/**
 * Deklaratív permission-mátrix (Feature-spec IAM/RBAC §3.3): permission_key → minimális szerep.
 */
model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  permissionKey String   @unique @map("permission_key")
  minRole       UserRole @map("min_role")
  description   String?
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("role_permissions")
}

/**
 * Fázis 3 erőforrás-szintű humán láthatóság horga (§3.4) — a Fázis 1-2-ben nincs kikényszerítve.
 */
model ResourceGrant {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String?             @map("tenant_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  resourceType ResourceGrantType   @map("resource_type")
  resourceId   String              @map("resource_id") @db.Uuid
  accessLevel  ResourceAccessLevel @map("access_level")
  grantedById  String              @map("granted_by") @db.Uuid
  grantedAt    DateTime            @default(now()) @map("granted_at") @db.Timestamptz

  user      User @relation("ResourceGrantUser", fields: [userId], references: [id])
  grantedBy User @relation("ResourceGrantGrantedBy", fields: [grantedById], references: [id])

  @@index([tenantId, userId])
  @@map("resource_grants")
}

model Agent {
  id                            String      @id @default(uuid()) @db.Uuid
  tenantId                      String?     @map("tenant_id") @db.Uuid
  name                          String
  // Szerep-instrukció ("mit csinál") és viselkedés-profil ("hogyan") külön
  // verziózva (§4.2/§5.3) — egymástól függetlenül frissíthető és visszakereshető.
  roleInstruction               String      @map("role_instruction")
  // A ténylegesen használt viselkedés-profil ("hogyan"): a választott megosztott
  // profil pinnelt törzse + az agent-specifikus `behaviorProfileOverlay` együtt,
  // egy szövegbe komponálva (composeBehaviorProfile). A runtime EZT olvassa, így a
  // prompt-építés és a reprodukálhatósági snapshot változatlan marad.
  behaviorProfile               String      @map("behavior_profile")
  // Az agent-specifikus, egyedileg szerkeszthető kiegészítés a megosztott profil
  // mellé (§3.4). Ez a "hogyan" azon része, ami csak erre az agentre igaz. Ha nincs
  // megosztott profil, önmagában ez adja a teljes viselkedés-profilt.
  behaviorProfileOverlay        String?     @map("behavior_profile_overlay")
  // Emberi arc (agent-persona.ts): admin által szerkeszthető megjelenített név,
  // üdvözlő mondat és jellemvonás. Ha null, a névből számított meleg
  // alapértelmezés jelenik meg. `avatarUrl` opcionális feltöltött portré
  // (data URL vagy külső URL); ha null, a gradiens+emoji arc látszik.
  personaNickname               String?     @map("persona_nickname")
  personaGreeting               String?     @map("persona_greeting")
  personaTrait                  String?     @map("persona_trait")
  avatarUrl                     String?     @map("avatar_url")
  modelConfig                   Json        @map("model_config")
  status                        AgentStatus @default(draft)
  currentVersion                Int         @default(1) @map("current_version")
  currentRoleInstructionVersion Int         @default(1) @map("current_role_instruction_version")
  currentBehaviorProfileVersion Int         @default(1) @map("current_behavior_profile_version")
  // Fázis 2 (§3.4): opcionális hivatkozás egy MEGOSZTOTT viselkedés-profilra. Ha
  // be van állítva, a `current_behavior_profile_version` a profil pinnelt al-verziója,
  // és a `behavior_profile` szöveg az elfogadott profil-al-verzió másolata (kaszkád).
  currentBehaviorProfileId      String?     @map("current_behavior_profile_id") @db.Uuid
  role                          AgentRole   @default(worker)
  // Sensitivity router (§4.7.2): ha true, egyik sensitivity szint sem blokkolja
  // vagy tereli helyi modellre az agent hívását. Az osztályozás és auditálás aktív
  // marad. Csak tenant admin / superadmin írhatja, minden váltás auditált.
  allowSensitiveExternalModel   Boolean     @default(false) @map("allow_sensitive_external_model")
  // Operator-láthatóság: ha true, non-admin szerepek (operator/approver/viewer)
  // nem látják az agentet a listákban és a detail oldalon. A futás/dispatch
  // NEM függ ettől — csak a UI/API láthatóság. Csak tenant admin írhatja.
  hiddenFromOperators           Boolean     @default(false) @map("hidden_from_operators")
  // Agent-hozzáférési gráf kapcsolói (Access-Policy §agent-scope, C4 kompatibilitási
  // alapérték). `inboundRestricted`: az agent FELÉ tartó view/address kapcsolat csak
  // explicit `AgentAccessGrant`-tal engedett. `outboundRestricted`: az agentBŐL induló
  // agent→agent view/address kapcsolat csak explicit granttal engedett. Alapérték
  // false/false → korlátozás nélkül a tenanton belüli kapcsolat grant nélkül engedett
  // (nincs migrációs élgenerálás, nincs shadow rollout).
  inboundRestricted             Boolean     @default(false) @map("inbound_restricted")
  outboundRestricted            Boolean     @default(false) @map("outbound_restricted")
  selfEvolutionProfile          Json?       @map("self_evolution_profile")
  memoryId                      String      @unique @map("memory_id") @db.Uuid
  createdAt                     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  // Fázis 2 életciklus (§4): a nyugdíjazás/felfüggesztés audithoz és reprodukálhatósághoz megőrzött.
  retiredAt                     DateTime?   @map("retired_at") @db.Timestamptz
  suspendedReason               String?     @map("suspended_reason")

  memory             Memory              @relation(fields: [memoryId], references: [id])
  behaviorProfileRef BehaviorProfile?    @relation(fields: [currentBehaviorProfileId], references: [id])
  versions           AgentVersion[]
  apiKeys            AgentApiKey[]
  agentResources     AgentResource[]
  tickets            Ticket[]
  ticketComments     TicketComment[]     @relation("TicketCommentAuthorAgent")
  modelCalls         ModelCall[]
  agentConnectors    AgentConnector[]
  capabilities       Capability[]
  agentSkills        AgentSkill[]
  toolCalls          ToolCall[]
  writeGateTokens    WriteGateToken[]
  memoryChunks       MemoryChunk[]       @relation("MemoryChunkAgent")
  memoryCandidates        MemoryCandidate[]        @relation("MemoryCandidateAgent")
  consequenceApprovals    ConsequenceApproval[]    @relation("ConsequenceApprovalAgent")
  evals                   Eval[]
  scheduledTasks          ScheduledTask[]
  monitorDefinitions      MonitorDefinition[]
  conversations           Conversation[]
  retentionPolicies       RetentionPolicy[]
  channelAgentGrants      ChannelAgentGrant[]      @relation("ChannelAgentGrantAgent")
  accessGrantsAsSubject   AgentAccessGrant[]       @relation("AgentAccessSubjectAgent")
  accessGrantsAsTarget    AgentAccessGrant[]       @relation("AgentAccessTarget")

  @@index([tenantId, status])
  @@index([tenantId, role])
  @@index([currentBehaviorProfileId])
  @@map("agents")
}

/// Agent-hozzáférési gráf éle (Access-Policy §agent-scope). Explicit, IRÁNYÍTOTT
/// allow-él: nincs címke-, szerep- vagy deny-szabály; A→B és B→A két külön sor.
/// A `canView` (a subject megtudhatja, hogy a cél létezik) és a `canAddress`
/// (chat/ticket/`agent_ask` indítható a cél felé) FÜGGETLEN boolean — egyik sem
/// implikálja a másikat. Egy subject→target párhoz legfeljebb egy sor tartozik, a két
/// boolean együtt hordozza a két vizuális sávot; ha mindkettő hamisra kerülne, a sor
/// törlődik (DB CHECK kényszeríti).
///
/// SZÁNDÉKOSAN nem a `ResourceGrant` táblát használjuk: annak alanya csak user lehet,
/// és az egyetlen `view | operate | approve` SKÁLA-igéje nem tudja kifejezni a két
/// független booleant.
model AgentAccessGrant {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  subjectType    AgentAccessSubjectType @map("subject_type")
  subjectUserId  String?                @map("subject_user_id") @db.Uuid
  subjectAgentId String?                @map("subject_agent_id") @db.Uuid
  targetAgentId  String                 @map("target_agent_id") @db.Uuid
  canView        Boolean                @default(false) @map("can_view")
  canAddress     Boolean                @default(false) @map("can_address")
  grantedById    String                 @map("granted_by") @db.Uuid
  grantedAt      DateTime               @default(now()) @map("granted_at") @db.Timestamptz
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectUser  User?  @relation("AgentAccessSubjectUser", fields: [subjectUserId], references: [id], onDelete: Cascade)
  subjectAgent Agent? @relation("AgentAccessSubjectAgent", fields: [subjectAgentId], references: [id], onDelete: Cascade)
  targetAgent  Agent  @relation("AgentAccessTarget", fields: [targetAgentId], references: [id], onDelete: Cascade)
  grantedBy    User   @relation("AgentAccessGrantedBy", fields: [grantedById], references: [id])

  @@unique([tenantId, subjectUserId, targetAgentId])
  @@unique([tenantId, subjectAgentId, targetAgentId])
  @@index([tenantId, targetAgentId])
  @@index([tenantId, subjectAgentId])
  @@map("agent_access_grants")
}

/// Megosztott, újrahasznosítható viselkedés-profil ("hogyan") — több agent hivatkozhatja
/// (egységes céges hangnem/nyelv/formázás/citálás). Feature-spec §3.4.
model BehaviorProfile {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  name           String
  currentVersion Int      @default(1) @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  versions BehaviorProfileVersion[]
  agents   Agent[]

  @@map("behavior_profiles")
}

model BehaviorProfileVersion {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  version      Int
  body         String
  // A write-gate alá esik (§4.6.1) — a jóváhagyó admin.
  approvedById String?  @map("approved_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile BehaviorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, version])
  @@map("behavior_profile_versions")
}

model AgentVersion {
  id                      String   @id @default(uuid()) @db.Uuid
  agentId                 String   @map("agent_id") @db.Uuid
  version                 Int
  roleInstructionSnapshot String   @map("role_instruction_snapshot")
  behaviorProfileSnapshot String   @map("behavior_profile_snapshot")
  // Mely al-verziókat fagyasztotta ez az agent-verzió (reprodukálhatóság).
  roleInstructionVersion  Int      @map("role_instruction_version")
  behaviorProfileVersion  Int      @map("behavior_profile_version")
  modelConfigSnapshot     Json     @map("model_config_snapshot")
  memoryVersionId         String   @map("memory_version_id") @db.Uuid
  recipeVersionId         String?  @map("recipe_version_id") @db.Uuid
  // A futáskor érvényes önfejlesztési kapu-profil befagyasztása (spec 3.2) — audithoz.
  selfEvolutionSnapshot   Json?    @map("self_evolution_snapshot")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent         Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  memoryVersion MemoryVersion  @relation(fields: [memoryVersionId], references: [id])
  recipeVersion RecipeVersion? @relation(fields: [recipeVersionId], references: [id])

  @@unique([agentId, version])
  @@map("agent_versions")
}

model Recipe {
  id         String           @id @default(uuid()) @db.Uuid
  name       String
  ticketType RecipeTicketType @map("ticket_type")
  scope      RecipeScope      @default(single)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  versions RecipeVersion[]

  @@map("recipes")
}

model RecipeVersion {
  id           String              @id @default(uuid()) @db.Uuid
  recipeId     String              @map("recipe_id") @db.Uuid
  version      Int
  content      Json
  status       RecipeVersionStatus @default(proposed)
  approvedById String?             @map("approved_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  recipe        Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  approvedBy    User?          @relation("RecipeApprovedBy", fields: [approvedById], references: [id])
  agentVersions AgentVersion[]

  @@unique([recipeId, version])
  @@map("recipe_versions")
}

// ── Skill-katalógus modellek (spec §3) ──────────────────────────────────────
// A meglévő `Recipe`-hez NEM nyúlunk (az az agent tanítási/interakciós útja).
model Skill {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  description  String // Level-0 index szöveg (méret-limitált)
  catalogScope SkillCatalogScope @default(tenant)
  tenantId     String?           @map("tenant_id") @db.Uuid // null ⇔ global
  sourceType   SkillSourceType   @default(authored)
  provenance   Json? // forrás-URL/id, eredeti hash, importált-formátum
  license      String? // SPDX vagy 'proprietary' / null
  riskTier     SkillRiskTier // F1: csak t0/t1
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz

  versions SkillVersion[]

  @@index([tenantId])
  @@map("skills")
}

model SkillVersion {
  id           String             @id @default(uuid()) @db.Uuid
  skillId      String             @map("skill_id") @db.Uuid
  version      Int
  content      Json // { instructions[], triggerKeywords[], parameters[] }
  requires     Json // capability-manifeszt: [{ toolName, reason }]
  status       SkillVersionStatus @default(proposed)
  contentHash  String             @map("content_hash")
  signature    String? // WriteGateToken-mechanizmussal aláírva (WP-7)
  approvedById String?            @map("approved_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  approvedBy  User?        @relation("SkillApprovedBy", fields: [approvedById], references: [id])
  agentSkills AgentSkill[]

  @@unique([skillId, version])
  @@map("skill_versions")
}

model AgentSkill {
  agentId        String   @map("agent_id") @db.Uuid
  skillVersionId String   @map("skill_version_id") @db.Uuid
  enabled        Boolean  @default(true)
  assignedById   String?  @map("assigned_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillVersion SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)

  @@id([agentId, skillVersionId])
  @@map("agent_skills")
}

model Playbook {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  processType String   @map("process_type")
  tenantId    String?  @map("tenant_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  versions PlaybookVersion[]

  @@map("playbooks")
}

model PlaybookVersion {
  id           String                @id @default(uuid()) @db.Uuid
  playbookId   String                @map("playbook_id") @db.Uuid
  version      Int
  spec         Json
  status       PlaybookVersionStatus @default(proposed)
  approvedById String?               @map("approved_by") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz

  playbook   Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("PlaybookApprovedBy", fields: [approvedById], references: [id])

  @@unique([playbookId, version])
  @@map("playbook_versions")
}

// --- Fázis 2 Playbook (Feature-spec — Playbook §4) ---------------------------
// Új, párhuzamos V2 réteg az objektum-alapú, verziózott Playbook-folyamatokhoz.
// A meglévő `playbooks` / `playbook_versions` táblákat NEM érinti.

enum PlaybookV2Status {
  draft
  published
  archived
  blocked
}

enum PlaybookVersionV2Status {
  draft
  pending_approval
  published
  rejected
  retired
}

// --- Fázis 2 Playbook process runtime (Feature-spec — Playbook §4.1) ---------

enum ProcessActorType {
  user
  agent
  system
}

enum ProcessStatus {
  created
  running
  awaiting_human
  blocked
  completed
  failed
  cancelled
}

enum ProcessStepStatus {
  pending
  ready
  in_progress
  awaiting_gate
  completed
  skipped
  failed
}

enum DelegationStatus {
  pending
  delivered
  accepted
  done
  failed
  cancelled
}

// --- Folyamat (Process Definition) réteg (Folyamat-feature-spec §1, §4.1) -----

enum ProcessDefinitionStatus {
  draft
  active
  archived
}

enum ProcessTriggerType {
  manual // Folyamatok-UI (kézi/teszt)
  ticket
  chat
  monitor_cron
}

model PlaybookV2 {
  id                        String           @id @default(uuid()) @db.Uuid
  tenantId                  String?          @map("tenant_id") @db.Uuid
  key                       String
  name                      String
  description               String?
  processType               String           @map("process_type")
  status                    PlaybookV2Status @default(draft)
  currentPublishedVersionId String?          @map("current_published_version_id") @db.Uuid
  ownerUserId               String?          @map("owner_user_id") @db.Uuid
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt                DateTime?        @map("archived_at") @db.Timestamptz

  versions           PlaybookVersionV2[]
  assignments        PlaybookAssignment[]
  processes          ProcessInstance[]
  processDefinitions ProcessDefinition[]

  @@unique([tenantId, key])
  @@map("playbooks_v2")
}

model PlaybookVersionV2 {
  id               String                  @id @default(uuid()) @db.Uuid
  tenantId         String?                 @map("tenant_id") @db.Uuid
  playbookId       String                  @map("playbook_id") @db.Uuid
  version          Int
  status           PlaybookVersionV2Status @default(draft)
  spec             Json
  compiledSpec     Json?                   @map("compiled_spec")
  // Canvas node-pozíciók / viewport — PREZENTÁCIÓ, a canonical contentHash-ből
  // KIZÁRVA (Governed Flow Builder D2). Alak: { nodes: { "<stepId|gateId>": { x, y } }, viewport?: {...} }.
  // Node arrébb húzása SOHA nem szül új contentHash-t vagy verziót.
  layout           Json                    @default("{}")
  validationResult Json                    @default("{}") @map("validation_result")
  changeSummary    String                  @map("change_summary")
  contentHash      String                  @map("content_hash")
  createdById      String                  @map("created_by_user_id") @db.Uuid
  approvedById     String?                 @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?               @map("approved_at") @db.Timestamptz
  publishedAt      DateTime?               @map("published_at") @db.Timestamptz
  retiredAt        DateTime?               @map("retired_at") @db.Timestamptz
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz

  playbook           PlaybookV2           @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  assignments        PlaybookAssignment[]
  processes          ProcessInstance[]
  processDefinitions ProcessDefinition[]

  @@unique([playbookId, version])
  @@unique([tenantId, playbookId, contentHash])
  @@map("playbook_versions_v2")
}

model PlaybookAssignment {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  playbookId        String    @map("playbook_id") @db.Uuid
  playbookVersionId String    @map("playbook_version_id") @db.Uuid
  assignmentType    String    @map("assignment_type")
  assignmentKey     String    @map("assignment_key")
  isDefault         Boolean   @default(false) @map("is_default")
  createdById       String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz

  playbook        PlaybookV2        @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  playbookVersion PlaybookVersionV2 @relation(fields: [playbookVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, assignmentType, assignmentKey])
  @@map("playbook_assignments")
}

// --- Governed Flow Builder — StepTemplate katalógus (§3.2, WP-3) --------------
// Governance-safe, újrahasznosítható lépés-legók a Canvas palettájához.
// A template SOHA nem ad futásidejű tool-jogot (D3) — a capability-t a Tool Broker
// kényszeríti ki runtime-ban; ez csak egy előkitöltött spec-fragment.

enum StepTemplateStatus {
  draft
  published
  retired
}

model StepTemplate {
  id                        String             @id @default(uuid()) @db.Uuid
  tenantId                  String?            @map("tenant_id") @db.Uuid // null = globális, admin-karbantartott
  key                       String
  name                      String
  description               String?
  category                  String?
  status                    StepTemplateStatus @default(draft)
  currentPublishedVersionId String?            @map("current_published_version_id") @db.Uuid
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt                DateTime?          @map("archived_at") @db.Timestamptz

  versions StepTemplateVersion[]

  @@unique([tenantId, key])
  @@map("step_templates")
}

model StepTemplateVersion {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  version     Int
  // Egy playbook-spec steps[]-fragment + ajánlott gate(ek), role-PLACEHOLDER-rel.
  // requiredCapabilities benne van, DE ez csak JAVASLAT — jogot nem ad (D3).
  fragment    Json
  contentHash String   @map("content_hash")
  // D8 — opcionális "certified" tier: a published-höz NEM kell eval, a certify-hoz igen.
  // evalSamples alak: [{ sampleInput, expectations[] }] — a hash-elt fragmenten KÍVÜL.
  certified   Boolean  @default(false)
  evalSamples Json     @default("[]") @map("eval_samples")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  template StepTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@map("step_template_versions")
}

// --- Fázis 2 Playbook process runtime (Feature-spec — Playbook §4.5–4.7) -----

model ProcessInstance {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String?             @map("tenant_id") @db.Uuid
  processType         String              @map("process_type")
  status              ProcessStatus       @default(created)
  playbookId          String              @map("playbook_id") @db.Uuid
  playbookVersionId   String              @map("playbook_version_id") @db.Uuid
  playbookRef         String              @map("playbook_ref")
  playbookContentHash String              @map("playbook_content_hash")
  // §7: a Futás forrás-Folyamata és triggere (opcionális a régi rekordok miatt).
  processDefinitionId String?             @map("process_definition_id") @db.Uuid
  triggerType         ProcessTriggerType? @map("trigger_type")
  startedByType       ProcessActorType    @map("started_by_type")
  startedByUserId     String?             @map("started_by_user_id") @db.Uuid
  startedByAgentId    String?             @map("started_by_agent_id") @db.Uuid
  conversationId      String?             @map("conversation_id") @db.Uuid
  rootTicketId        String?             @map("root_ticket_id") @db.Uuid
  inputPayload        Json                @default("{}") @map("input_payload")
  outputPayload       Json                @default("{}") @map("output_payload")
  startedAt           DateTime            @default(now()) @map("started_at") @db.Timestamptz
  completedAt         DateTime?           @map("completed_at") @db.Timestamptz
  failedAt            DateTime?           @map("failed_at") @db.Timestamptz

  playbook          PlaybookV2            @relation(fields: [playbookId], references: [id])
  playbookVersion   PlaybookVersionV2     @relation(fields: [playbookVersionId], references: [id])
  processDefinition ProcessDefinition?    @relation(fields: [processDefinitionId], references: [id])
  steps             ProcessStepInstance[]
  delegations       DelegationEdge[]

  @@index([tenantId, status])
  @@index([tenantId, processType])
  @@index([processDefinitionId])
  @@map("process_instances")
}

model ProcessStepInstance {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String?           @map("tenant_id") @db.Uuid
  processInstanceId String            @map("process_instance_id") @db.Uuid
  stepId            String            @map("step_id")
  stepName          String            @map("step_name")
  status            ProcessStepStatus @default(pending)
  assignedRole      String            @map("assigned_role")
  assignedAgentId   String?           @map("assigned_agent_id") @db.Uuid
  assignedUserId    String?           @map("assigned_user_id") @db.Uuid
  ticketId          String?           @map("ticket_id") @db.Uuid
  startedAt         DateTime?         @map("started_at") @db.Timestamptz
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz
  failedAt          DateTime?         @map("failed_at") @db.Timestamptz
  resultPayload     Json              @default("{}") @map("result_payload")

  process ProcessInstance @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)

  @@unique([processInstanceId, stepId])
  @@index([tenantId, status])
  @@map("process_step_instances")
}

model DelegationEdge {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String?          @map("tenant_id") @db.Uuid
  processInstanceId String           @map("process_instance_id") @db.Uuid
  fromStepId        String           @map("from_step_id")
  toStepId          String           @map("to_step_id")
  fromTicketId      String?          @map("from_ticket_id") @db.Uuid
  toTicketId        String?          @map("to_ticket_id") @db.Uuid
  fromActorType     ProcessActorType @map("from_actor_type")
  fromAgentId       String?          @map("from_agent_id") @db.Uuid
  fromUserId        String?          @map("from_user_id") @db.Uuid
  toActorType       ProcessActorType @map("to_actor_type")
  toAgentId         String?          @map("to_agent_id") @db.Uuid
  toUserId          String?          @map("to_user_id") @db.Uuid
  status            DelegationStatus @default(pending)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  deliveredAt       DateTime?        @map("delivered_at") @db.Timestamptz
  acceptedAt        DateTime?        @map("accepted_at") @db.Timestamptz
  doneAt            DateTime?        @map("done_at") @db.Timestamptz
  failedAt          DateTime?        @map("failed_at") @db.Timestamptz
  metadata          Json             @default("{}")

  process ProcessInstance @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, processInstanceId])
  @@map("delegation_edges")
}

/// Folyamat (2. szint): egy publikált Playbook-verzióra PIN-elt, konfigurált,
/// nevesített, újrahasználható definíció. Folyamat-feature-spec §1, §4.1.
model ProcessDefinition {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String?                 @map("tenant_id") @db.Uuid
  name              String
  description       String?
  status            ProcessDefinitionStatus @default(draft)
  // PIN a publikált Playbook-verzióra (§4.10). A verzió cseréje tudatos, külön aktus.
  playbookId        String                  @map("playbook_id") @db.Uuid
  playbookVersionId String                  @map("playbook_version_id") @db.Uuid
  // roleKey -> agentId leképezés a Folyamaton (§4.1, §1.2). { "reviewer": "<uuid>", ... }
  roleBindings      Json                    @default("{}") @map("role_bindings")
  // config-forrású rések értékei (§4.7). { "sablon": "...", ... }
  configValues      Json                    @default("{}") @map("config_values")
  createdById       String                  @map("created_by_user_id") @db.Uuid
  approvedById      String?                 @map("approved_by_user_id") @db.Uuid
  approvedAt        DateTime?               @map("approved_at") @db.Timestamptz
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt        DateTime?               @map("archived_at") @db.Timestamptz

  playbook        PlaybookV2        @relation(fields: [playbookId], references: [id])
  playbookVersion PlaybookVersionV2 @relation(fields: [playbookVersionId], references: [id])
  triggers        ProcessTrigger[]
  instances       ProcessInstance[]

  @@index([tenantId, status])
  @@map("process_definitions")
}

/// Egy Folyamathoz kötött trigger (§4.4). Egy Folyamatnak több triggere lehet.
model ProcessTrigger {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String?            @map("tenant_id") @db.Uuid
  processDefinitionId String             @map("process_definition_id") @db.Uuid
  type                ProcessTriggerType
  enabled             Boolean            @default(true)
  // trigger-input -> deklarált rés leképezés (§4.4). Alakja triggertípus-függő:
  //  ticket:       { fieldMap: { "<slotName>": "<ticketFieldKey>" } }
  //  chat:         { slotNames: ["cég", ...] }
  //  monitor_cron: { contextMap: { "<slotName>": "now()" | "<collectorField>" } }
  //  manual:       {}  (az operátor űrlapon tölt)
  inputMap            Json               @default("{}") @map("input_map")
  // monitor_cron esetén a forrás MonitorDefinition (opcionális FK-ként is tükrözve)
  monitorDefinitionId String?            @map("monitor_definition_id") @db.Uuid
  createdById         String             @map("created_by_user_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  revokedAt           DateTime?          @map("revoked_at") @db.Timestamptz

  processDefinition ProcessDefinition @relation(fields: [processDefinitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@index([processDefinitionId])
  @@map("process_triggers")
}

model AgentApiKey {
