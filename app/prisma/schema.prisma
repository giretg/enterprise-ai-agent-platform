  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memory         Memory          @relation("MemoryCandidates", fields: [memoryId], references: [id], onDelete: Cascade)
  agent          Agent           @relation("MemoryCandidateAgent", fields: [agentId], references: [id], onDelete: Cascade)
  ticket         Ticket?         @relation(fields: [ticketId], references: [id])
  writeGateToken WriteGateToken?

  @@index([memoryId, projectKey, status])
  @@index([agentId, status])
  @@map("memory_candidates")
