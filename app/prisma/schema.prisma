  projectKey    String  @map("project_key")
  workstreamKey String? @map("workstream_key")

  operation String
  payload   Json
  status    String @default("proposed")

  proposedBy         String  @map("proposed_by")
  proposedByRunId    String? @map("proposed_by_run_id")
  proposedInThreadId String? @map("proposed_in_thread_id")
  ticketId           String? @map("ticket_id") @db.Uuid

  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz
  rejectedBy String?   @map("rejected_by") @db.Uuid
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz

  writeGateTokenId String? @map("write_gate_token_id") @db.Uuid

