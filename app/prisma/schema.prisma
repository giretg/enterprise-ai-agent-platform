  createdFromRunId    String?          @map("created_from_run_id") @db.Uuid

  buildCost Json @default("{}") @map("build_cost")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project SandboxProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, seq])
  // NB: a tree_hash NEM unique — a rollback szándékosan új commitot hoz létre egy
  // korábbi (azonos tartalmú) fára (invariáns 2 / SV3), ami ütközne a unique-kal.
  @@index([tenantId, projectId, treeHash])
  @@index([projectId])
  @@map("sandbox_commits")
}

model SandboxPromotion {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String? @map("tenant_id") @db.Uuid
  projectId String  @map("project_id") @db.Uuid

  fromCommitId           String  @map("from_commit_id") @db.Uuid
  prevLiveCommitId       String? @map("prev_live_commit_id") @db.Uuid
  prePromotionSnapshotId String? @map("pre_promotion_snapshot_id") @db.Uuid

  status SandboxPromotionStatus @default(pending_approval)

  requestedByType    SandboxActorType @map("requested_by_type")
  requestedByUserId  String?          @map("requested_by_user_id") @db.Uuid
  requestedByAgentId String?          @map("requested_by_agent_id") @db.Uuid
  approvedByUserId   String?          @map("approved_by_user_id") @db.Uuid
  reason             String?

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz
  promotedAt  DateTime? @map("promoted_at") @db.Timestamptz

  project SandboxProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("sandbox_promotions")
}

model SandboxDataSnapshot {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String?    @map("tenant_id") @db.Uuid
  projectId String     @map("project_id") @db.Uuid
  env       SandboxEnv

  kind   SandboxSnapshotKind
  status SandboxSnapshotStatus @default(creating)

  snapshotRef String  @map("snapshot_ref")
  schemaHash  String  @map("schema_hash")
  rowCount    BigInt? @map("row_count")
  sizeBytes   BigInt? @map("size_bytes")

  createdByType     SandboxActorType @map("created_by_type")
  createdByUserId   String?          @map("created_by_user_id") @db.Uuid
  linkedPromotionId String?          @map("linked_promotion_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  project SandboxProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, env])
  @@map("sandbox_data_snapshots")
}

model SandboxExport {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String? @map("tenant_id") @db.Uuid
  projectId String  @map("project_id") @db.Uuid

  scope            SandboxExportScope
  sourceCommitId   String             @map("source_commit_id") @db.Uuid
  sourceSnapshotId String?            @map("source_snapshot_id") @db.Uuid

  status                    SandboxExportStatus @default(requested)
  packageRef                String?             @map("package_ref")
  packageHash               String?             @map("package_hash")
  manifest                  Json                @default("{}")
  responsibilityTransferred Boolean             @default(false) @map("responsibility_transferred")

  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz

  project SandboxProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("sandbox_exports")
}

// ── Fázis 2: Write-gate token ──────────────────────────────────────────────

enum WriteGateTokenStatus {
  issued
  consumed
  expired
  revoked
}

model WriteGateToken {
  id                String               @id @default(uuid()) @db.Uuid
  // §9.4: az inline (ticket nélküli) memória-jóváhagyáshoz nullable — pontosan
  // az egyik horgony (trainingTicketId vagy memoryCandidateId) töltött ki;
  // az invariánst a MemoryApprovalService/TrainingService alkalmazás-szinten őrzi.
  trainingTicketId  String?              @map("training_ticket_id") @db.Uuid
  memoryCandidateId String?              @unique @map("memory_candidate_id") @db.Uuid
  agentId           String               @map("agent_id") @db.Uuid
  targetMemoryId    String               @map("target_memory_id") @db.Uuid
  expectedDiffHash  String               @map("expected_diff_hash")
  tokenHash         String               @map("token_hash")
  signature         String
  status            WriteGateTokenStatus @default(issued)
  issuedAt          DateTime             @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt         DateTime             @map("expires_at") @db.Timestamptz
  consumedAt        DateTime?            @map("consumed_at") @db.Timestamptz

  trainingTicket  Ticket?          @relation(fields: [trainingTicketId], references: [id], onDelete: Cascade)
  memoryCandidate MemoryCandidate? @relation(fields: [memoryCandidateId], references: [id], onDelete: Cascade)
  agent           Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  targetMemory    Memory           @relation(fields: [targetMemoryId], references: [id], onDelete: Cascade)

  @@map("write_gate_tokens")
}

// ── §4.4: tanítási ticket first-class metaadata (a write-gate köti) ─────────

model TrainingTicket {
  ticketId            String  @id @map("ticket_id") @db.Uuid
  proposedDiff        Json    @map("proposed_diff")
  writeGateTokenRef   String? @map("write_gate_token_ref")
  evalResult          Json?   @map("eval_result")
  targetMemoryVersion Int     @map("target_memory_version")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("training_tickets")
}

// ── Fázis 2: Eval-kapu ────────────────────────────────────────────────────

enum EvalStatus {
  active
  retired
}

enum EvalRunTrigger {
  pre_training_approval
  scheduled
  manual
}

model Eval {
  id        String     @id @default(uuid()) @db.Uuid
  agentId   String     @map("agent_id") @db.Uuid
  name      String
  goldenSet Json       @map("golden_set")
  status    EvalStatus @default(active)

  agent Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs  EvalRun[]

  @@map("evals")
}

model EvalRun {
  id              String         @id @default(uuid()) @db.Uuid
  evalId          String         @map("eval_id") @db.Uuid
  trigger         EvalRunTrigger
  agentVersion    Int            @map("agent_version")
  memoryVersionId String?        @map("memory_version_id") @db.Uuid
  passed          Boolean
  score           Float
  details         Json
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  eval          Eval           @relation(fields: [evalId], references: [id], onDelete: Cascade)
  memoryVersion MemoryVersion? @relation(fields: [memoryVersionId], references: [id])

  @@map("eval_runs")
}

/// Globális, runtime-állítható platform-beállítások (kulcs-érték). Pl. a dispatcher
/// kill-switch és poll-intervallum, amit a felhős worker minden ciklusban újraolvas.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}
