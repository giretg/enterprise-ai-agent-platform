model Resource {
  id        String        @id @default(uuid()) @db.Uuid
  type      ResourceType
  name      String
  scope     ResourceScope
  version   Int           @default(1)
  dataRef   String        @map("data_ref")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  agentResources AgentResource[]

  @@map("resources")
}

model AgentResource {
  agentId    String     @map("agent_id") @db.Uuid
  resourceId String     @map("resource_id") @db.Uuid
  accessMode AccessMode @map("access_mode")

  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([agentId, resourceId])
  @@map("agent_resources")
}

model Connector {
  id             String                  @id @default(uuid()) @db.Uuid
  type           ConnectorType
  name           String
  authMode       ConnectorAuthMode       @default(service) @map("auth_mode")
  scope          ConnectorScope
  secretAlias    String?                 @map("secret_alias")
  version        Int                     @default(1)
  config         Json                    @default("{}")
  lifecycleState ConnectorLifecycleState @default(active) @map("lifecycle_state")
  tenantId       String?                 @map("tenant_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz

  // ── Önfrissítő connector (Dev-Spec — Self-Updating-Connector) ──
  // `fixed` a default; `self_updating` esetén a futásidejű képességet az
  // `activeSpecVersion` capabilitySet-je adja (A3), nem a `config.endpoints`.
  connectorMode       ConnectorMode         @default(fixed) @map("connector_mode")
  activeSpecVersionId String?               @map("active_spec_version_id") @db.Uuid
  activeSpecVersion   ConnectorSpecVersion? @relation("ActiveSpecVersion", fields: [activeSpecVersionId], references: [id], onDelete: SetNull)

  agentConnectors    AgentConnector[]
  toolCalls          ToolCall[]
  documents          Document[]
  grants             ConnectorGrant[]
  draft              ConnectorDraft?
  knowledgeArtifacts KnowledgeArtifact[]
  specSource         ConnectorSpecSource?
  specVersions       ConnectorSpecVersion[] @relation("SpecVersions")

  // §4.2: tenant-scope egyediség — a régi @@unique([type, name]) cross-tenant
  // névütközést okozott (két tenant nem használhatta ugyanazt a connector-nevet).
  @@unique([tenantId, type, name])
  @@map("connectors")
}

model ConnectorTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  key         String
  version     Int                     @default(1)
  origin      ConnectorTemplateOrigin @default(custom)
  displayName String                  @map("display_name")
  description String?
  tenantId    String?                 @map("tenant_id") @db.Uuid
  descriptor  Json
  status      ConnectorTemplateStatus @default(active)
  createdById String?                 @map("created_by") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([key, version, tenantId])
  @@index([origin, status])
  @@map("connector_templates")
}

// A draft eredetét, forrását és validációs eredményét külön tartjuk, hogy a
// `connectors` tábla tiszta maradjon (Feature-spec — Provisioning-Assistant §4.2).
// A forrásdokumentum TARTALMA sosem kerül ide — csak a `sourceHash` + storage-ref.
model ConnectorDraft {
  id                          String                     @id @default(uuid()) @db.Uuid
  tenantId                    String?                    @map("tenant_id") @db.Uuid
  connectorId                 String                     @unique @map("connector_id") @db.Uuid
  sourceType                  ConnectorDraftSourceType   @map("source_type")
  sourceRef                   String?                    @map("source_ref")
  sourceHash                  String                     @map("source_hash")
  generatedByAgentId          String?                    @map("generated_by_agent_id") @db.Uuid
  generatedByAgentVersion     Int?                       @map("generated_by_agent_version")
  generatedFromConversationId String?                    @map("generated_from_conversation_id") @db.Uuid
  validationResult            Json?                      @map("validation_result")
  reviewStatus                ConnectorDraftReviewStatus @default(pending) @map("review_status")
  reviewedById                String?                    @map("reviewed_by") @db.Uuid
  secondApproverId            String?                    @map("second_approver_id") @db.Uuid
  sandboxTestOk               Boolean?                   @map("sandbox_test_ok")
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, connectorId])
  @@map("connector_drafts")
}

// ── Önfrissítő connector: spec-forrás (Dev-Spec §5) ─────────────────────────
// A connectorhoz kötött, JÓVÁHAGYOTT link, amiről a szinkron a leírást húzza.
// A titok (kulcs) NEM ide kerül — az a Connector.secretAlias mögött marad (A6).
// A `specUrl`-t egyszer explicit jóvá kell hagyni (T2/A4), utána oda van szögezve.
model ConnectorSpecSource {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  connectorId       String    @unique @map("connector_id") @db.Uuid
  connector         Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  specUrl           String    @map("spec_url") // A4: pinned, jóváhagyott link
  specFormat        String    @default("openapi_3") @map("spec_format") // jövőállóság (D1)
  urlApprovedById   String?   @map("url_approved_by") @db.Uuid // ki hagyta jóvá a linket (T2)
  urlApprovedAt     DateTime? @map("url_approved_at") @db.Timestamptz
  trustedById       String?   @map("trusted_by") @db.Uuid // T1: explicit partner-bizalmi minősítés
  trustedAt         DateTime? @map("trusted_at") @db.Timestamptz
  autoApprovePolicy Json?     @map("auto_approve_policy") // D5/T4: mi mehet emberi kapu nélkül
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamptz
  createdById       String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("connector_spec_sources")
}

// ── Önfrissítő connector: verziózott spec-pillanatkép (Dev-Spec §5, §7 A7) ──
// Append-only történet. `rawSnapshot` a bizonyíték ("ezt töltöttük le, ekkor"),
// `capabilitySet` a kiparse-olt, strukturált képességlista (a broker ezt érti).
// Egyszerre pontosan egy `approved` verzió az aktív (Connector.activeSpecVersionId).
model ConnectorSpecVersion {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String?                    @map("tenant_id") @db.Uuid
  connectorId       String                     @map("connector_id") @db.Uuid
  connector         Connector                  @relation("SpecVersions", fields: [connectorId], references: [id], onDelete: Cascade)
  versionNo         Int                        @map("version_no") // 1,2,3… append-only
  rawSnapshot       Json                       @map("raw_snapshot") // nyers spec (bizonyíték)
  rawHash           String                     @map("raw_hash") // tartalom-hash (A4/A5)
  capabilitySet     Json                       @map("capability_set") // kiparse-olt, strukturált képességek
  status            ConnectorSpecVersionStatus @default(proposed)
  diffFromVersionId String?                    @map("diff_from_version_id") @db.Uuid
  diffSummary       Json?                      @map("diff_summary") // A2: gépi diff (§6)
  fetchedAt         DateTime                   @default(now()) @map("fetched_at") @db.Timestamptz
  approvedById      String?                    @map("approved_by") @db.Uuid
  approvedAt        DateTime?                  @map("approved_at") @db.Timestamptz
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  activeForConnectors Connector[] @relation("ActiveSpecVersion")

  @@unique([connectorId, versionNo])
  @@index([connectorId, status])
  @@map("connector_spec_versions")
}

model ConnectorGrant {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String?              @map("tenant_id") @db.Uuid
  connectorId     String               @map("connector_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  status          ConnectorGrantStatus @default(active)
  scopes          Json                 @default("[]")
  tokenRef        String               @unique @map("token_ref")
  accountLabel    String?              @map("account_label")
  grantedAt       DateTime             @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt       DateTime?            @map("expires_at") @db.Timestamptz
  lastRefreshedAt DateTime?            @map("last_refreshed_at") @db.Timestamptz
  revokedAt       DateTime?            @map("revoked_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, connectorId, userId])
  @@map("connector_grants")
}

model AgentConnector {
  agentId     String              @map("agent_id") @db.Uuid
  connectorId String              @map("connector_id") @db.Uuid
  accessMode  ConnectorAccessMode @map("access_mode")
  secretAlias String?             @map("secret_alias")

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@id([agentId, connectorId])
  @@map("agent_connectors")
}

model Capability {
  agentId   String   @map("agent_id") @db.Uuid
  toolName  String   @map("tool_name")
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, toolName])
  @@map("capabilities")
}

model Document {
  id            String         @id @default(uuid()) @db.Uuid
  filename      String
  storageRef    String         @map("storage_ref")
  extractedText String?        @map("extracted_text")
  status        DocumentStatus @default(uploaded)
  connectorId   String?        @map("connector_id") @db.Uuid
  uploadedById  String         @map("uploaded_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  // KB-v3 (§8.2) — opcionális metaadat + feldolgozási mód. Meglévő sorok
  // változatlanul működnek (mind nullable / default).
  mimeType       String?                  @map("mime_type")
  contentHash    String?                  @map("content_hash")
  processingMode KnowledgeProcessingMode? @map("processing_mode")
  metadata       Json                     @default("{}")

  uploadedBy               User                      @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  connector                Connector?                @relation(fields: [connectorId], references: [id])
  tickets                  Ticket[]
  artifacts                KnowledgeArtifact[]
  ticketCommentAttachments TicketCommentAttachment[]

  @@index([connectorId, status])
  @@map("documents")
}

// ── KB-v3 adatmodell (§8.3/§8.4) ────────────────────────────────────────────
// A scope-kulcs a `connectorId` (D-B); az `agentId` legfeljebb nullable
// provenance, retrievalben SOHA nem szűr. A `tenantId` a `system` tenantnál is
// valós UUID (D-E, lásd SYSTEM_TENANT_ID) — nincs NULL-izolációs ág.
model KnowledgeArtifact {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String? @map("tenant_id") @db.Uuid
  connectorId      String  @map("connector_id") @db.Uuid // SCOPE-KULCS
  createdByAgentId String? @map("created_by_agent_id") @db.Uuid // provenance, NEM scope
  sourceDocumentId String? @map("source_document_id") @db.Uuid

  format               KnowledgeArtifactFormat @default(okf_v0_1)
  status               KnowledgeArtifactStatus @default(draft)
  version              Int
  contentHash          String                  @map("content_hash")
  bundleRef            String                  @map("bundle_ref")
  generationModel      String?                 @map("generation_model")
  generationPromptHash String?                 @map("generation_prompt_hash")
  validationResult     Json                    @default("{}") @map("validation_result")
  reviewSummary        String?                 @map("review_summary")
  createdById          String?                 @map("created_by") @db.Uuid
  approvedById         String?                 @map("approved_by") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  publishedAt          DateTime?               @map("published_at") @db.Timestamptz

  connector      Connector        @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  sourceDocument Document?        @relation(fields: [sourceDocumentId], references: [id])
  chunks         KnowledgeChunk[]

  @@unique([connectorId, sourceDocumentId, version])
  @@index([tenantId, connectorId, status])
  @@index([connectorId, status])
  @@map("knowledge_artifacts")
}

model KnowledgeChunk {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String? @map("tenant_id") @db.Uuid
  artifactId  String  @map("artifact_id") @db.Uuid
  connectorId String  @map("connector_id") @db.Uuid // SCOPE-KULCS (D-B)

  path        String
  title       String
  type        String
  section     String?
  chunkIndex  Int     @map("chunk_index")
  text        String
  summary     String?
  tags        Json    @default("[]")
  metadata    Json    @default("{}")
  sourceRef   Json?   @map("source_ref") // oldal/section-szint (§4.7), NEM span-pontos
  contentHash String  @map("content_hash")

  // Full-text: Postgres tsvector GIN index nyers SQL migrationnel (később).
  // NINCS embedding mező (D-A). A vektor a KnowledgeIndexStore mögött adható hozzá.

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  artifact KnowledgeArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([tenantId, connectorId])
  @@index([connectorId])
  @@index([artifactId, path])
  @@map("knowledge_chunks")
}

model Conversation {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String?            @map("tenant_id") @db.Uuid
  agentId           String             @map("agent_id") @db.Uuid
  title             String?
  status            ConversationStatus @default(active)
  // agent-memory-persistent-cross-conversation-spec.md §2.1: chat-oldali
  // projektfolytonossági scope-kulcs; soft-default a per-tenant+agent
  // "__general__" projektre, a chat-fejléc projekt-választója írja.
  projectKey        String             @default("__general__") @map("project_key")
  createdById       String             @map("created_by") @db.Uuid
  retentionPolicyId String?            @map("retention_policy_id") @db.Uuid
  retainUntil       DateTime?          @map("retain_until") @db.Timestamptz
  legalHold         Boolean            @default(false) @map("legal_hold")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  lastMessageAt     DateTime           @default(now()) @map("last_message_at") @db.Timestamptz

  // Csatorna-megjelölés (Telegram feature-spec #70, D14): ha a beszélgetés egy
  // csatorna-adapteren (pl. Telegram) keresztül él, ez jelöli a csatorna típusát és
  // a külső szál-azonosítót. Webes beszélgetésnél mindkettő null.
  channel           ChannelType?       @map("channel")
  channelExternalId String?            @map("channel_external_id")

  agent           Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  retentionPolicy RetentionPolicy? @relation(fields: [retentionPolicyId], references: [id])
  messages             Message[]
  tickets              Ticket[]
  modelCalls           ModelCall[]
  toolCalls            ToolCall[]
  agentTurns           AgentTurn[]
  channelSessions      ChannelSession[]
  consequenceApprovals ConsequenceApproval[]

  @@index([tenantId, agentId, lastMessageAt])
  @@index([tenantId, createdById])
  @@index([retainUntil, legalHold])
  @@index([channel, channelExternalId])
  @@map("conversations")
}

/// Következmény-kapu pending jóváhagyás — a blokkolt mellékhatásos tool teljes
/// args-ával. Jóváhagyáskor a szerver egyszer lefuttatja a toolt (agent újraindítás nélkül).
model ConsequenceApproval {
  id             String                     @id @default(uuid()) @db.Uuid
  conversationId String                     @map("conversation_id") @db.Uuid
  agentId        String                     @map("agent_id") @db.Uuid
  agentVersion   Int                        @map("agent_version")
  tenantId       String?                    @map("tenant_id") @db.Uuid
  actingUserId   String?                    @map("acting_user_id") @db.Uuid
  ticketId       String?                    @map("ticket_id") @db.Uuid
  toolName       String                     @map("tool_name")
  /// Teljes tool-args a broker.invoke újrafuttatásához (NEM a sanitizált argsMeta).
  args           Json
  status         ConsequenceApprovalStatus  @default(pending)
  blockedToolCallId String?                 @map("blocked_tool_call_id") @db.Uuid
  resultMeta     Json?                      @map("result_meta")
  approvedBy     String?                    @map("approved_by") @db.Uuid
  approvedAt     DateTime?                  @map("approved_at") @db.Timestamptz
  rejectedBy     String?                    @map("rejected_by") @db.Uuid
  rejectedAt     DateTime?                  @map("rejected_at") @db.Timestamptz
  expiresAt      DateTime                   @map("expires_at") @db.Timestamptz
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation("ConsequenceApprovalAgent", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([agentId, status])
  @@index([expiresAt, status])
  @@map("consequence_approvals")
}

model Message {
  id               String              @id @default(uuid()) @db.Uuid
  conversationId   String              @map("conversation_id") @db.Uuid
  seq              Int
  role             MessageRole
  actingUserId     String?             @map("acting_user_id") @db.Uuid
  agentVersion     Int?                @map("agent_version")
  model            String?
  contentRef       String?             @map("content_ref")
  contentHash      String?             @map("content_hash")
  contentDeletedAt DateTime?           @map("content_deleted_at") @db.Timestamptz
  ticketRefId      String?             @map("ticket_ref") @db.Uuid
  auditEventRef    String?             @map("audit_event_ref")
  criticality      MessageCriticality?
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actingUser   User?        @relation("MessageActingUser", fields: [actingUserId], references: [id])
  ticketRef    Ticket?      @relation(fields: [ticketRefId], references: [id])

  @@unique([conversationId, seq])
  @@index([conversationId, createdAt])
  @@index([contentDeletedAt])
  @@map("messages")
}

/// chat-agent-turn-resilience-spec.md §4 (D1/D7/D8-Tier-2) — a chat-agent-forduló
/// első osztályú, perzisztált rekordja. A `messages` a végállapot; ez a köztes,
/// élő rekord, ami a haladást (részszöveg, aktivitások), az elszámolókat és a
/// futtatás-tulajdonlást (lock + heartbeat, a `Ticket` dispatcher-konvenciója
/// szerint) hordozza. Lezáráskor `assistantMessageId`-vel mutat a keletkezett
/// agent-üzenetre.
///
/// Aktív-forduló invariáns (D7): egy `conversationId`-hez legfeljebb EGY
/// `queued|running|streaming` sor lehet. Ezt a `0009_agent_turn` migráció
/// részleges egyedi indexe kényszeríti ki (Prisma-sémában nem kifejezhető).
model AgentTurn {
  id                 String          @id @default(uuid()) @db.Uuid
  conversationId     String          @map("conversation_id") @db.Uuid
  tenantId           String?         @map("tenant_id") @db.Uuid
  agentId            String          @map("agent_id") @db.Uuid
  agentVersion       Int             @map("agent_version")
  createdById        String          @map("created_by") @db.Uuid
  status             AgentTurnStatus @default(queued)
  /**
   * A forduló-helyet a user-üzenet perzisztálása ELŐTT foglaljuk (D7/#61), hogy
   * az elutasított küldés ne hagyjon árva üzenetet — a foglalás és a bekötés
   * közötti pillanatban ezért üres.
   */
  userMessageId      String?         @map("user_message_id") @db.Uuid
  assistantMessageId String?         @map("assistant_message_id") @db.Uuid

  // Haladás / reconnect-snapshot (§5.3)
  partialText String @default("") @map("partial_text")
  activities  Json   @default("[]")

  // Loop-elszámolók (§7)
  turnCount     Int @default(0) @map("turn_count")
  toolCallCount Int @default(0) @map("tool_call_count")
  deniedCount   Int @default(0) @map("denied_count")

  // Kontroll (D6)
  cancelRequested     Boolean   @default(false) @map("cancel_requested")
  cancelRequestedById String?   @map("cancel_requested_by") @db.Uuid
  cancelRequestedAt   DateTime? @map("cancel_requested_at") @db.Timestamptz

  // Életciklus / lock (Tier-2, D8/D10)
  lockToken   String?   @map("lock_token")
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz
  heartbeatAt DateTime  @default(now()) @map("heartbeat_at") @db.Timestamptz
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz
  reason      String?
  error       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([status, heartbeatAt])
  @@map("agent_turns")
}

// ── Csatorna-réteg entitások (Telegram feature-spec #70, D14) ───────────────
// Ez a slice CSAK az adatmodellt és a platform-bot regisztrációját hozza; a
// bejövő webhook, az összekötés és a futásidő későbbi ticketek. A cél, hogy a
// későbbi szeleteknek legyen mire épülniük.

/// Regisztrált csatorna-bot (D3/D14). A `tenantId` üresen hagyható = platform-szintű
/// bot (a connectoroknál bevált platform-vs-szervezet minta szerint). A hozzáférési
/// kulcs és a webhook titkos fejléc SOHA nem nyersen, csak TITOK-REFERENCIAKÉNT
/// tárolódik (`accessKeySecretRef` / `webhookSecretRef` — pl. `env:...`,
/// `secret-manager:...`), és a felületen sosem olvasható vissza. Egyetlen platform-bot
/// él csatorna-típusonként (részleges egyedi index, `tenant_id IS NULL`).
model ChannelBot {
  id                 String           @id @default(uuid()) @db.Uuid
  channelType        ChannelType      @map("channel_type")
  tenantId           String?          @map("tenant_id") @db.Uuid
  name               String
  accessKeySecretRef String           @map("access_key_secret_ref")
  webhookSecretRef   String           @map("webhook_secret_ref")
  status             ChannelBotStatus @default(active)
  createdById        String?          @map("created_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  sessions ChannelSession[]

  // Szervezeti bot egyediség típusonként; a platform-bot (tenant_id IS NULL)
  // egyediségét a migráció részleges egyedi indexe kényszeríti ki (Prisma-sémában
  // a NULL-ok külön értékek, ezért ott nem kifejezhető).
  @@unique([channelType, tenantId])
  @@index([channelType, status])
  @@map("channel_bots")
}

/// Külső fiók ↔ platform-felhasználó kötés (D2/D14). A `tenantId` a kötéskor RÖGZÍTETT
/// szervezet. A `lookupHash` a külső azonosító determinisztikus, egyedi kereső-hashe
/// (a nyers külső azonosító csak titkosítva, `externalUserIdEnc`). SZEREPKÖRT NEM tárol —
/// az minden üzenetnél élőben oldódik fel a tagságból (D2).
model ChannelIdentity {
  id                String                @id @default(uuid()) @db.Uuid
  channelType       ChannelType           @map("channel_type")
  externalUserIdEnc String                @map("external_user_id_enc")
  lookupHash        String                @map("lookup_hash")
  tenantId          String?               @map("tenant_id") @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  status            ChannelIdentityStatus @default(active)
  linkedAt          DateTime              @default(now()) @map("linked_at") @db.Timestamptz
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  user     User                @relation("ChannelIdentityUser", fields: [userId], references: [id], onDelete: Cascade)
  grants   ChannelAgentGrant[]
  sessions ChannelSession[]

  @@unique([channelType, lookupHash])
  @@index([userId, status])
  @@index([tenantId, status])
  @@map("channel_identities")
}

/// Melyik agent érhető el a csatornán, kinek, melyik projekttel (D5/D9/D14). Nem új
/// jogosultság-forrás, hanem SZŰKÍTÉS: a platform-oldali hozzáféréssel vett metszet.
/// A `projectKey` alapértéke a gyűjtő (`__general__`).
model ChannelAgentGrant {
  id          String   @id @default(uuid()) @db.Uuid
  identityId  String   @map("identity_id") @db.Uuid
  agentId     String   @map("agent_id") @db.Uuid
  projectKey  String   @default("__general__") @map("project_key")
  grantedById String?  @map("granted_by") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  identity ChannelIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  agent    Agent           @relation("ChannelAgentGrantAgent", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([identityId, agentId])
  @@index([agentId])
  @@map("channel_agent_grants")
}

/// Külső szál ↔ beszélgetés összerendelés (D8/D9/D14). Az `updateWatermark` a Telegram
/// monoton növekvő frissítés-azonosítójának munkamenetenkénti vízjele (D15 duplikáció-
/// védelem). A `lastActivityAt` a 24 órás gördülő beszélgetéshez (D9).
model ChannelSession {
  id               String   @id @default(uuid()) @db.Uuid
  botId            String   @map("bot_id") @db.Uuid
  externalThreadId String   @map("external_thread_id")
  conversationId   String?  @map("conversation_id") @db.Uuid
  identityId       String?   @map("identity_id") @db.Uuid
  activeAgentId    String?   @map("active_agent_id") @db.Uuid
  updateWatermark  BigInt?   @map("update_watermark")
  // D12 — a bekötetlen küldő EGYETLEN semleges választ kap, utána csend ugyanabban a
  // szálban. Ez a bélyeg jelöli, hogy a semleges válasz már kiment; ha ki van töltve,
  // a további bekötetlen üzenetek némán elnyelődnek (nem generálnak kimenő hívást).
  unlinkedNoticeAt DateTime? @map("unlinked_notice_at") @db.Timestamptz
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  bot          ChannelBot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversation Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  identity     ChannelIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  turns        ChannelTurn[]
  outboundMessages ChannelOutboundMessage[]

  @@unique([botId, externalThreadId])
  @@index([identityId])
  @@index([lastActivityAt])
  @@map("channel_sessions")
}

/// A worker munkasora — a második munkatípus (D8/D14). Egy bejövő üzenet egy sor;
/// a forduló túléli a webhook-kérést, `attempts` szerint újrapróbálható, `lastError`
/// diagnosztizálható.
model ChannelTurn {
  id         String            @id @default(uuid()) @db.Uuid
  sessionId  String            @map("session_id") @db.Uuid
  inboundRef String?           @map("inbound_ref")
  /// A bejövő üzenet szövege (D14 „bejövő üzenet"). A worker ebből futtatja a fordulót;
  /// a webhook-kérés túlélése ezt igényli (a nyers Telegram-üzenetet sehol máshol nem
  /// tároljuk). Fájl/hang esetén null — a `inboundKind` jelzi, hogy nem szöveg.
  inboundText String?           @map("inbound_text")
  /// A bejövő üzenet fajtája: `text` (feldolgozható) vagy `unsupported` (fájl/kép/hang —
  /// a bot érthetően megmondja, hogy ezt még nem tudja kezelni; nincs agent-futás).
  inboundKind String            @default("text") @map("inbound_kind")
  status     ChannelTurnStatus @default(queued)
  attempts   Int               @default(0)
  lastError  String?           @map("last_error")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  session ChannelSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([status, createdAt])
  @@map("channel_turns")
}

/// A bot SAJÁT kimenő üzeneteinek nyilvántartása a megőrzési takarításhoz (D4/#78).
/// A hiteles példány a MIÉNK; a Telegram csak kézbesítési csatorna. A bot a megőrzési
/// horizonton takarítja a saját kimenő üzeneteit — privát chatben CSAK a magáéit tudja
/// törölni (a felhasználóét nem), ezért ez a tábla KIZÁRÓLAG a bot által küldött
/// üzenetek `providerMessageId`-ját tárolja (nyers tartalom NÉLKÜL), hogy a takarító a
/// `deleteMessage` hívásokhoz tudja a (chat, message) párost. A `purgedAt` billen, amint
/// a törlés megtörtént (vagy a provider szerint az üzenet már nem létezik) — idempotens.
model ChannelOutboundMessage {
  id                String      @id @default(uuid()) @db.Uuid
  sessionId         String      @map("session_id") @db.Uuid
  channelType       ChannelType @map("channel_type")
  /// A cél-chat külső azonosítója (a `deleteMessage` chat_id-ja). Nem tartalom.
  externalThreadId  String      @map("external_thread_id")
  /// A provider által adott üzenet-azonosító (a `deleteMessage` message_id-ja).
  providerMessageId String      @map("provider_message_id")
  /// Diagnosztikai kategória a kimenő üzenetről (pl. `link_established`) — NEM a szöveg.
  kind              String?
  sentAt            DateTime    @default(now()) @map("sent_at") @db.Timestamptz
  /// Kitöltve, amint a megőrzési takarítás törölte (vagy a provider szerint már nincs meg).
  purgedAt          DateTime?   @map("purged_at") @db.Timestamptz

  session ChannelSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // A takarító a régi, még nem takarított sorokat kéri le (sentAt szerint, purgedAt IS NULL).
  @@index([purgedAt, sentAt])
  @@index([sessionId])
  @@map("channel_outbound_messages")
}

/// Deep-link összekötő token (Telegram feature-spec #70/#72, D12). A webes „Telegram
/// összekötése" gomb egy RÖVID ÉLETTARTAMÚ, EGYSZER FELHASZNÁLHATÓ tokent állít elő,
/// amibe bele van kötve a SZERVEZET, a FELHASZNÁLÓ és a LEJÁRAT — aláírva
/// (`signature`, HMAC a `jti`+szervezet+felhasználó+lejárat felett; a beváltás konstans
/// idővel ellenőrzi). A Telegram `start` paramétere legfeljebb 64 karakter, ezért a
/// mélylink CSAK a rövid `jti`-t hordozza; az aláírt kötés (mezők + `signature`) itt,
/// szerveroldalon él (a write-gate token `tokenHash`+`signature` mintáját követve).
/// Az egyszer-használatot a `consumedAt` atomi billentése kényszeríti (verseny-biztos).
model ChannelLinkToken {
  id                   String      @id @default(uuid()) @db.Uuid
  channelType          ChannelType @map("channel_type")
  /// A mélylink `start` paramétere — rövid, kitalálhatatlan, egyedi (nem a nyers azonosító).
  jti                  String      @unique
  /// HMAC-aláírás a kötött mezők felett (integritás + hamisítás-detektálás, konstans idejű vetés).
  signature            String
  userId               String      @map("user_id") @db.Uuid
  /// A kötéskor RÖGZÍTETT szervezet (D2). Üres = platform-szintű felhasználó.
  tenantId             String?     @map("tenant_id") @db.Uuid
  expiresAt            DateTime    @map("expires_at") @db.Timestamptz
  /// Beváltáskor töltődik ki (egyszer-használat). A második beváltás nem hoz létre kötést.
  consumedAt           DateTime?   @map("consumed_at") @db.Timestamptz
  /// A beváltó külső fiók kereső-hashe — a kettős-koppintás idempotens sikeréhez
  /// (ugyanaz a fiók) vs. a továbbküldött-link elutasításához (más fiók).
  consumedByLookupHash String?     @map("consumed_by_lookup_hash")
  createdById          String?     @map("created_by") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user User @relation("ChannelLinkTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("channel_link_tokens")
}

/// Eseményvezérelt jóváhagyás Telegram-gombokkal (Telegram feature-spec #70/#76, D5/D6/D14).
/// Amikor egy ticket `awaiting_human`-ba lép, a felelős / jóváhagyói kör jogosultság-tudatos
/// gombokat kap; EGY sor = EGY címzettnek kiküldött gombüzenet. A sor hordozza a KÖTÉST
/// (ticket, kapu, címzett-identitás, kezdeményező, kért szerepkör) és a megengedett döntéseket,
/// hogy a koppintáskor a szerver élőben újra tudja ellenőrizni a jogosultságot, és az
/// EGYSZER-használatot atomian (a `status` `pending`→`decided` billentése, verseny-biztos)
/// kikényszerítse. A gomb-payload aláírása a kötött mezők felett képződik (l.
/// `channel-approval-token.ts`); a nyers külső azonosító SOHA nem kerül ide (csak a
/// `recipientIdentityId` és a döntéskor a beváltó kereső-hashe a kettős-koppintás idempotenciához).
model ChannelApprovalPrompt {
  id                  String      @id @default(uuid()) @db.Uuid
  /// A `callback_data` rövid, kitalálhatatlan kulcsa (nem a nyers azonosító).
  promptId            String      @unique @map("prompt_id")
  channelType         ChannelType @map("channel_type")
  ticketId            String      @map("ticket_id") @db.Uuid
  /// A kötéskor rögzített szervezet (D2). Üres = platform-szintű.
  tenantId            String?     @map("tenant_id") @db.Uuid
  /// A kötelező kapu azonosítója (ha van); a döntés a kapun keresztül lépteti az állapotgépet.
  gateId              String?     @map("gate_id")
  stepId              String?     @map("step_id")
  /// A kért jóváhagyói szerepkör — a koppintáskori ÉLŐ jogosultság-ellenőrzéshez.
  requiredActorRole   String?     @map("required_actor_role")
  /// A CÍMZETT csatorna-identitása — a gomb ehhez a címzetthez van kötve (más fiók nem váltja be).
  recipientIdentityId String      @map("recipient_identity_id") @db.Uuid
  recipientUserId     String      @map("recipient_user_id") @db.Uuid
  /// A kezdeményező — a „saját kérés jóváhagyása tiltott" élő ellenőrzéséhez.
  initiatorUserId     String?     @map("initiator_user_id") @db.Uuid
  /// A ténylegesen megjelenített (jogosultság-tudatos) döntések: az `approve`/`reject` részhalmaza.
  allowedActions      String[]    @map("allowed_actions")
  /// A cél-chat külső azonosítója (a döntés utáni `editMessageReplyMarkup` chat_id-ja).
  externalThreadId    String      @map("external_thread_id")
  /// A kiküldött gombüzenet provider-azonosítója (a döntés utáni szerkesztéshez/gombeltüntetéshez).
  providerMessageId   String?     @map("provider_message_id")
  /// pending | decided | superseded. A `decided` billentés atomi és verseny-biztos (egyszer-használat).
  status              String      @default("pending")
  decidedAction       String?     @map("decided_action")
  /// A beváltó külső fiók kereső-hashe — a kettős-koppintás idempotens nyugtázásához.
  decidedByLookupHash String?     @map("decided_by_lookup_hash")
  decidedAt           DateTime?   @map("decided_at") @db.Timestamptz
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([ticketId, status])
  @@index([recipientIdentityId])
  @@map("channel_approval_prompts")
}

/// Platform-oldali felhasználói értesítés (Telegram feature-spec #70/#72, D12 story 3).
/// Egyelőre az összekötés tényéről szól — ha nem a felhasználó kötött, azonnal lássa és
/// megszüntethesse. Szándékosan általános (kind + title + body + metadata), hogy később más
/// események is ide írhassanak. A `readAt` az „elolvasva" jelölés.
model UserNotification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  kind      String
  title     String
  body      String
  metadata  Json      @default("{}")
