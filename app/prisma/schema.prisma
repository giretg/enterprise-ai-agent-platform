generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  approver
  operator
  viewer
}

enum UserStatus {
  pending
  active
  suspended
}

enum InvitationStatus {
  pending
  redeemed
  expired
}

enum AgentStatus {
  draft
  active
  retired
}

enum AgentRole {
  worker
  orchestrator
}

enum PlaybookVersionStatus {
  proposed
  active
  retired
}

enum ApiKeyStatus {
  active
  revoked
}

enum MemoryVersionStatus {
  proposed
  active
  rolled_back
}

enum ResourceType {
  secret
  policy
  file
  dataset
  connector
  tool
}

enum ResourceScope {
  global
  group
  single
}

enum AccessMode {
  read
  use
}

enum ConnectorType {
  knowledge_base
  board
  gmail
  workspace
  http_api
}

enum ConnectorAuthMode {
  service
  user_delegated
  agent_owned
}

enum ConnectorGrantStatus {
  active
  revoked
  expired
}

enum ConnectorScope {
  global
  single
}

enum ConnectorAccessMode {
  read
  write
}

enum ToolCallStatus {
  ok
  denied
  error
}

enum ModelCallStatus {
  ok
  error
  rate_limited
}

enum RecipeTicketType {
  interaction
  training
}

enum RecipeScope {
  global
  single
}

enum RecipeVersionStatus {
  proposed
  active
  retired
}

enum TicketType {
  interaction
  training
  monitor_alert
}

enum TicketState {
  backlog
  ready
  approved
  in_progress
  awaiting_human
  done
  rejected
}

enum TicketSource {
  user
  test
  system
}

enum ScheduledTaskStatus {
  active
  materializing
  materialized
  revoked
}

enum ScheduledTaskKind {
  agent_task
  wiki_question
}

enum ScheduledTaskRecurrence {
  none
  daily
  weekly
  monthly
}

enum MonitorKind {
  board_backlog
  deadline
  connector_count
  composite
}

enum MonitorStatus {
  active
  paused
  revoked
}

enum MonitorRunOutcome {
  quiet
  escalated
  suppressed
  skipped
  error
}

enum MonitorCatchupPolicy {
  run_late
  skip
}

enum AssigneeType {
  human
  agent
}

enum DocumentStatus {
  uploaded
  processing
  processed
  failed
}

enum AuditActorType {
  human
  agent
  system
}

enum SandboxAppLevel {
  A0
  A1
  A2
  A3
}

enum SandboxAppType {
  single_html
  static_bundle
  sandbox_data_app
  integrated_app
}

enum SandboxAppStatus {
  draft
  active
  archived
  blocked
}

enum SandboxAppVersionStatus {
  draft
  active
  superseded
  blocked
}

enum SandboxAppCriticality {
  L0
  L1
  L2
  L3
}

enum SandboxCreatedByType {
  user
  agent
  system
}

enum ConversationStatus {
  active
  archived
}

enum MessageRole {
  user
  agent
  system
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  externalAuthId String     @unique @map("external_auth_id")
  email          String
  name           String
  role           UserRole   @default(viewer)
  status         UserStatus @default(active) @map("status")
  tenantId       String?    @map("tenant_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz

  approvedMemoryVersions        MemoryVersion[]   @relation("MemoryApprovedBy")
  approvedRecipeVersions        RecipeVersion[]   @relation("RecipeApprovedBy")
  approvedPlaybookVersions      PlaybookVersion[] @relation("PlaybookApprovedBy")
  createdTickets                Ticket[]          @relation("TicketCreatedBy")
  uploadedDocuments             Document[]        @relation("DocumentUploadedBy")
  createdInvitations            Invitation[]      @relation("InvitationCreatedBy")
  connectorGrants               ConnectorGrant[]
  scheduledTasksCreated         ScheduledTask[]   @relation("ScheduledTaskCreatedBy")
  scheduledTasksRunAs           ScheduledTask[]   @relation("ScheduledTaskRunAsUser")
  scheduledTasksRunAsAuthorized ScheduledTask[]   @relation("ScheduledTaskRunAsAuthorizedBy")
  monitorDefinitionsCreated     MonitorDefinition[] @relation("MonitorDefinitionCreatedBy")

  @@map("users")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  email       String
  role        UserRole
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(pending)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz
  redeemedAt  DateTime?        @map("redeemed_at") @db.Timestamptz
  createdById String           @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  createdBy User @relation("InvitationCreatedBy", fields: [createdById], references: [id])

  @@map("invitations")
}

model Agent {
  id                            String      @id @default(uuid()) @db.Uuid
  name                          String
  // Szerep-instrukció ("mit csinál") és viselkedés-profil ("hogyan") külön
  // verziózva (§4.2/§5.3) — egymástól függetlenül frissíthető és visszakereshető.
  roleInstruction               String      @map("role_instruction")
  behaviorProfile               String      @map("behavior_profile")
  modelConfig                   Json        @map("model_config")
  status                        AgentStatus @default(draft)
  currentVersion                Int         @default(1) @map("current_version")
  currentRoleInstructionVersion Int         @default(1) @map("current_role_instruction_version")
  currentBehaviorProfileVersion Int         @default(1) @map("current_behavior_profile_version")
  role                          AgentRole   @default(worker)
  selfEvolutionProfile          Json?       @map("self_evolution_profile")
  memoryId                      String      @unique @map("memory_id") @db.Uuid
  createdAt                     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  memory          Memory           @relation(fields: [memoryId], references: [id])
  versions        AgentVersion[]
  apiKeys         AgentApiKey[]
  agentResources  AgentResource[]
  tickets         Ticket[]
  modelCalls      ModelCall[]
  agentConnectors AgentConnector[]
  capabilities    Capability[]
  toolCalls       ToolCall[]
  writeGateTokens WriteGateToken[]
  evals           Eval[]
  scheduledTasks  ScheduledTask[]
  monitorDefinitions MonitorDefinition[]

  @@map("agents")
}

model AgentVersion {
  id                      String   @id @default(uuid()) @db.Uuid
  agentId                 String   @map("agent_id") @db.Uuid
  version                 Int
  roleInstructionSnapshot String   @map("role_instruction_snapshot")
  behaviorProfileSnapshot String   @map("behavior_profile_snapshot")
  // Mely al-verziókat fagyasztotta ez az agent-verzió (reprodukálhatóság).
  roleInstructionVersion  Int      @map("role_instruction_version")
  behaviorProfileVersion  Int      @map("behavior_profile_version")
  modelConfigSnapshot     Json     @map("model_config_snapshot")
  memoryVersionId         String   @map("memory_version_id") @db.Uuid
  recipeVersionId         String?  @map("recipe_version_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent         Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  memoryVersion MemoryVersion  @relation(fields: [memoryVersionId], references: [id])
  recipeVersion RecipeVersion? @relation(fields: [recipeVersionId], references: [id])

  @@unique([agentId, version])
  @@map("agent_versions")
}

model Recipe {
  id         String           @id @default(uuid()) @db.Uuid
  name       String
  ticketType RecipeTicketType @map("ticket_type")
  scope      RecipeScope      @default(single)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  versions RecipeVersion[]

  @@map("recipes")
}

model RecipeVersion {
  id           String              @id @default(uuid()) @db.Uuid
  recipeId     String              @map("recipe_id") @db.Uuid
  version      Int
  content      Json
  status       RecipeVersionStatus @default(proposed)
  approvedById String?             @map("approved_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  recipe        Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  approvedBy    User?          @relation("RecipeApprovedBy", fields: [approvedById], references: [id])
  agentVersions AgentVersion[]

  @@unique([recipeId, version])
  @@map("recipe_versions")
}

model Playbook {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  processType String   @map("process_type")
  tenantId    String?  @map("tenant_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  versions PlaybookVersion[]

  @@map("playbooks")
}

model PlaybookVersion {
  id           String                @id @default(uuid()) @db.Uuid
  playbookId   String                @map("playbook_id") @db.Uuid
  version      Int
  spec         Json
  status       PlaybookVersionStatus @default(proposed)
  approvedById String?               @map("approved_by") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz

  playbook   Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("PlaybookApprovedBy", fields: [approvedById], references: [id])

  @@unique([playbookId, version])
  @@map("playbook_versions")
}

// --- Fázis 2 Playbook (Feature-spec — Playbook §4) ---------------------------
// Új, párhuzamos V2 réteg az objektum-alapú, verziózott Playbook-folyamatokhoz.
// A meglévő MVP `playbooks` / `playbook_versions` táblákat NEM érinti.

enum PlaybookV2Status {
  draft
  published
  archived
  blocked
}

enum PlaybookVersionV2Status {
  draft
  pending_approval
  published
  rejected
  retired
}

model PlaybookV2 {
  id                        String           @id @default(uuid()) @db.Uuid
  tenantId                  String?          @map("tenant_id") @db.Uuid
  key                       String
  name                      String
  description               String?
  processType               String           @map("process_type")
  status                    PlaybookV2Status @default(draft)
  currentPublishedVersionId String?          @map("current_published_version_id") @db.Uuid
  ownerUserId               String?          @map("owner_user_id") @db.Uuid
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt                DateTime?        @map("archived_at") @db.Timestamptz

  versions    PlaybookVersionV2[]
  assignments PlaybookAssignment[]

  @@unique([tenantId, key])
  @@map("playbooks_v2")
}

model PlaybookVersionV2 {
  id               String                  @id @default(uuid()) @db.Uuid
  tenantId         String?                 @map("tenant_id") @db.Uuid
  playbookId       String                  @map("playbook_id") @db.Uuid
  version          Int
  status           PlaybookVersionV2Status @default(draft)
  spec             Json
  compiledSpec     Json?                   @map("compiled_spec")
  validationResult Json                    @default("{}") @map("validation_result")
  changeSummary    String                  @map("change_summary")
  contentHash      String                  @map("content_hash")
  createdById      String                  @map("created_by_user_id") @db.Uuid
  approvedById     String?                 @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?               @map("approved_at") @db.Timestamptz
  publishedAt      DateTime?               @map("published_at") @db.Timestamptz
  retiredAt        DateTime?               @map("retired_at") @db.Timestamptz
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz

  playbook    PlaybookV2           @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  assignments PlaybookAssignment[]

  @@unique([playbookId, version])
  @@unique([tenantId, playbookId, contentHash])
  @@map("playbook_versions_v2")
}

model PlaybookAssignment {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  playbookId        String    @map("playbook_id") @db.Uuid
  playbookVersionId String    @map("playbook_version_id") @db.Uuid
  assignmentType    String    @map("assignment_type")
  assignmentKey     String    @map("assignment_key")
  isDefault         Boolean   @default(false) @map("is_default")
  createdById       String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz

  playbook        PlaybookV2        @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  playbookVersion PlaybookVersionV2 @relation(fields: [playbookVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, assignmentType, assignmentKey])
  @@map("playbook_assignments")
}

model AgentApiKey {
  id         String       @id @default(uuid()) @db.Uuid
  agentId    String       @map("agent_id") @db.Uuid
  keyHash    String       @map("key_hash")
  scopes     Json
  status     ApiKeyStatus @default(active)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime?    @map("last_used_at") @db.Timestamptz

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_api_keys")
}

model Memory {
  id               String  @id @default(uuid()) @db.Uuid
  currentVersionId String? @map("current_version_id") @db.Uuid

  agent           Agent?
  versions        MemoryVersion[]  @relation("MemoryVersions")
  currentVersion  MemoryVersion?   @relation("MemoryCurrentVersion", fields: [currentVersionId], references: [id])
  writeGateTokens WriteGateToken[]

  @@map("memories")
}

model MemoryVersion {
  id               String              @id @default(uuid()) @db.Uuid
  memoryId         String              @map("memory_id") @db.Uuid
  version          Int
  content          String
  diffFromPrevious Json?               @map("diff_from_previous")
  status           MemoryVersionStatus @default(proposed)
  source           String?
  approvedById     String?             @map("approved_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz

  memory           Memory         @relation("MemoryVersions", fields: [memoryId], references: [id], onDelete: Cascade)
  approvedBy       User?          @relation("MemoryApprovedBy", fields: [approvedById], references: [id])
  agentVersions    AgentVersion[]
  currentForMemory Memory[]       @relation("MemoryCurrentVersion")
  evalRuns         EvalRun[]

  @@unique([memoryId, version])
  @@map("memory_versions")
}

model Resource {
  id        String        @id @default(uuid()) @db.Uuid
  type      ResourceType
  name      String
  scope     ResourceScope
  version   Int           @default(1)
  dataRef   String        @map("data_ref")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  agentResources AgentResource[]

  @@map("resources")
}

model AgentResource {
  agentId    String     @map("agent_id") @db.Uuid
  resourceId String     @map("resource_id") @db.Uuid
  accessMode AccessMode @map("access_mode")

  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([agentId, resourceId])
  @@map("agent_resources")
}

model Connector {
  id          String            @id @default(uuid()) @db.Uuid
  type        ConnectorType
  name        String
  authMode    ConnectorAuthMode @default(service) @map("auth_mode")
  scope       ConnectorScope
  secretAlias String?           @map("secret_alias")
  version     Int               @default(1)
  config      Json              @default("{}")
  tenantId    String?           @map("tenant_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  agentConnectors AgentConnector[]
  toolCalls       ToolCall[]
  documents       Document[]
  grants          ConnectorGrant[]

  @@unique([type, name])
  @@map("connectors")
}

model ConnectorGrant {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String?              @map("tenant_id") @db.Uuid
  connectorId     String               @map("connector_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  status          ConnectorGrantStatus @default(active)
  scopes          Json                 @default("[]")
  tokenRef        String               @unique @map("token_ref")
  accountLabel    String?              @map("account_label")
  grantedAt       DateTime             @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt       DateTime?            @map("expires_at") @db.Timestamptz
  lastRefreshedAt DateTime?            @map("last_refreshed_at") @db.Timestamptz
  revokedAt       DateTime?            @map("revoked_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, connectorId, userId])
  @@map("connector_grants")
}

model AgentConnector {
  agentId     String              @map("agent_id") @db.Uuid
  connectorId String              @map("connector_id") @db.Uuid
  accessMode  ConnectorAccessMode @map("access_mode")

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@id([agentId, connectorId])
  @@map("agent_connectors")
}

model Capability {
  agentId   String   @map("agent_id") @db.Uuid
  toolName  String   @map("tool_name")
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, toolName])
  @@map("capabilities")
}

model Document {
  id            String         @id @default(uuid()) @db.Uuid
  filename      String
  storageRef    String         @map("storage_ref")
  extractedText String?        @map("extracted_text")
  status        DocumentStatus @default(uploaded)
  connectorId   String?        @map("connector_id") @db.Uuid
  uploadedById  String         @map("uploaded_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  uploadedBy User       @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  connector  Connector? @relation(fields: [connectorId], references: [id])
  tickets    Ticket[]

  @@map("documents")
}

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String?            @map("tenant_id") @db.Uuid
  agentId       String             @map("agent_id") @db.Uuid
  title         String?
  status        ConversationStatus @default(active)
  createdById   String             @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  lastMessageAt DateTime           @default(now()) @map("last_message_at") @db.Timestamptz

  messages   Message[]
  tickets    Ticket[]
  modelCalls ModelCall[]
  toolCalls  ToolCall[]

  @@map("conversations")
}

model Message {
  id               String      @id @default(uuid()) @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  seq              Int
  role             MessageRole
  agentVersion     Int?        @map("agent_version")
  model            String?
  contentRef       String?     @map("content_ref")
  contentDeletedAt DateTime?   @map("content_deleted_at") @db.Timestamptz
  ticketRefId      String?     @map("ticket_ref") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticketRef    Ticket?      @relation(fields: [ticketRefId], references: [id])

  @@unique([conversationId, seq])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Ticket {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String?       @map("tenant_id") @db.Uuid
  type             TicketType
  title            String
  state            TicketState   @default(backlog)
  assigneeType     AssigneeType? @map("assignee_type")
  assigneeId       String?       @map("assignee_id") @db.Uuid
  agentId          String?       @map("agent_id") @db.Uuid
  payload          Json          @default("{}")
  sourceDocumentId String?       @map("source_document_id") @db.Uuid
  executeAfter     DateTime?     @map("execute_after") @db.Timestamptz
  dueBy            DateTime?     @map("due_by") @db.Timestamptz
  lockToken        String?       @map("lock_token")
  lockedAt         DateTime?     @map("locked_at") @db.Timestamptz
  playbookRef      String?       @map("playbook_ref")
  conversationId   String?       @map("conversation_id") @db.Uuid
  source           TicketSource  @default(user)
  createdById      String        @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  agent                         Agent?              @relation(fields: [agentId], references: [id])
  sourceDocument                Document?           @relation(fields: [sourceDocumentId], references: [id])
  conversation                  Conversation?       @relation(fields: [conversationId], references: [id])
  createdBy                     User                @relation("TicketCreatedBy", fields: [createdById], references: [id])
  modelCalls                    ModelCall[]
  toolCalls                     ToolCall[]
  writeGateTokens               WriteGateToken[]
  transitions                   TicketTransition[]
  trainingTicket                TrainingTicket?
  sandboxAppVersions            SandboxAppVersion[]
  linkedMessages                Message[]
  scheduledTaskMaterializations ScheduledTask[]

  @@index([source, state])
  @@index([tenantId, state])
  @@map("tickets")
}

model ScheduledTask {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String?                 @map("tenant_id") @db.Uuid
  kind                 ScheduledTaskKind       @default(agent_task)
  status               ScheduledTaskStatus     @default(active)
  recurrence           ScheduledTaskRecurrence @default(none)
  maxRuns              Int?                    @map("max_runs")
  runCount             Int                     @default(0) @map("run_count")
  title                String
  agentId              String                  @map("agent_id") @db.Uuid
  createdById          String                  @map("created_by") @db.Uuid
  payload              Json                    @default("{}")
  runAsUserId          String?                 @map("run_as_user_id") @db.Uuid
  runAsAuthorizedAt    DateTime?               @map("run_as_authorized_at") @db.Timestamptz
  runAsAuthorizedById  String?                 @map("run_as_authorized_by") @db.Uuid
  nextRunAt            DateTime                @map("next_run_at") @db.Timestamptz
  lastRunAt            DateTime?               @map("last_run_at") @db.Timestamptz
  materializedTicketId String?                 @map("materialized_ticket_id") @db.Uuid
  materializedAt       DateTime?               @map("materialized_at") @db.Timestamptz
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  agent              Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy          User    @relation("ScheduledTaskCreatedBy", fields: [createdById], references: [id])
  runAsUser          User?   @relation("ScheduledTaskRunAsUser", fields: [runAsUserId], references: [id])
  runAsAuthorizedBy  User?   @relation("ScheduledTaskRunAsAuthorizedBy", fields: [runAsAuthorizedById], references: [id])
  materializedTicket Ticket? @relation(fields: [materializedTicketId], references: [id])

  @@index([status, nextRunAt])
  @@map("scheduled_tasks")
}

/// Proaktív monitor-definíció (Feature-spec — Proactive Monitor §3.2).
/// Determinisztikus, ütemezett figyelő-szabály: mit figyel, milyen küszöbbel,
/// milyen frekvenciával, és mit tesz találatkor. A drága LLM csak a 2. lépcsőben
/// (eszkaláció) indul — a söprés maga nulla LLM-token.
model MonitorDefinition {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  kind             MonitorKind
  status           MonitorStatus        @default(active)
  version          Int                  @default(1)
  title            String
  description      String?

  // Ütemezés (§4.11.6) — UTC-ben tárolva
  intervalSeconds  Int                  @map("interval_seconds")
  nextSweepAt      DateTime             @map("next_sweep_at") @db.Timestamptz
  lastSweepAt      DateTime?            @map("last_sweep_at") @db.Timestamptz
  activeWindowCron String?              @map("active_window_cron")
  catchupPolicy    MonitorCatchupPolicy @default(run_late) @map("catchup_policy")
  catchupWindowSec Int                  @default(900) @map("catchup_window_sec")

  // 1. lépcső — determinisztikus collector + szűrő konfiguráció
  collectorConfig  Json                 @default("{}") @map("collector_config")
  filterConfig     Json                 @default("{}") @map("filter_config")

  // Riasztás-fáradtság elleni kontroll
  cooldownSeconds  Int                  @default(86400) @map("cooldown_seconds")
  dedupKeyTemplate String?              @map("dedup_key_template")

  // 2. lépcső — eszkalációs akció
  openTicketType   TicketType           @default(monitor_alert) @map("open_ticket_type")
  escalateAgentId  String?              @map("escalate_agent_id") @db.Uuid
  perRunBudgetUsd  Decimal?             @map("per_run_budget_usd") @db.Decimal(10, 4)
  notifyChannel    String?              @map("notify_channel")

  // Lock (dupla-fire védelem — §4.11.7)
  lockToken        String?              @map("lock_token")
  lockedAt         DateTime?            @map("locked_at") @db.Timestamptz

  createdById      String               @map("created_by") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  escalateAgent    Agent?               @relation(fields: [escalateAgentId], references: [id])
  createdBy        User                 @relation("MonitorDefinitionCreatedBy", fields: [createdById], references: [id])
  runs             MonitorRun[]
  signals          MonitorSignal[]

  @@index([status, nextSweepAt])
  @@index([tenantId, status])
  @@map("monitor_definitions")
}

/// Egy söprés-végrehajtás auditmagja (§3.3). A @@unique([monitorId, scheduledFor])
/// a §4.11.7 „dupla-fires védelem" adatbázis-szintű garanciája.
model MonitorRun {
  id              String            @id @default(uuid()) @db.Uuid
  monitorId       String            @map("monitor_id") @db.Uuid
  outcome         MonitorRunOutcome
  startedAt       DateTime          @default(now()) @map("started_at") @db.Timestamptz
  finishedAt      DateTime?         @map("finished_at") @db.Timestamptz
  scheduledFor    DateTime          @map("scheduled_for") @db.Timestamptz
  signalCount     Int               @default(0) @map("signal_count")
  matchedCount    Int               @default(0) @map("matched_count")
  suppressedCount Int               @default(0) @map("suppressed_count")
  openedTicketIds String[]          @map("opened_ticket_ids") @db.Uuid
  llmInvoked      Boolean           @default(false) @map("llm_invoked")
  costUsd         Decimal?          @map("cost_usd") @db.Decimal(10, 4)
  error           String?

  monitor         MonitorDefinition @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([monitorId, scheduledFor])
  @@index([monitorId, startedAt])
  @@map("monitor_runs")
}

/// Cooldown / dedup nyilvántartás (§3.4): ugyanaz a jel ne nyisson ismételt
/// tickettet a cooldown ablakon belül (riasztás-fáradtság elleni kontroll).
model MonitorSignal {
  id                String            @id @default(uuid()) @db.Uuid
  monitorId         String            @map("monitor_id") @db.Uuid
  dedupKey          String            @map("dedup_key")
  firstSeenAt       DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt        DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz
  lastEscalatedAt   DateTime?         @map("last_escalated_at") @db.Timestamptz
  escalatedTicketId String?           @map("escalated_ticket_id") @db.Uuid
  severity          Int               @default(0)
  payload           Json              @default("{}")

  monitor           MonitorDefinition @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([monitorId, dedupKey])
  @@index([monitorId, lastEscalatedAt])
  @@map("monitor_signals")
}

model TicketTransition {
  id           String         @id @default(uuid()) @db.Uuid
  ticketId     String         @map("ticket_id") @db.Uuid
  fromState    TicketState    @map("from_state")
  toState      TicketState    @map("to_state")
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id") @db.Uuid
  agentVersion Int?           @map("agent_version")
  note         String?
  ts           DateTime       @default(now()) @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, ts])
  @@map("ticket_transitions")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  seq            BigInt         @default(autoincrement())
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Uuid
  agentVersion   Int?           @map("agent_version")
  action         String
  targetType     String         @map("target_type")
  targetId       String?        @map("target_id") @db.Uuid
  modelUsed      String?        @map("model_used")
  inputRef       String?        @map("input_ref")
  outputRef      String?        @map("output_ref")
  policyDecision String?        @map("policy_decision")
  prevHash       String?        @map("prev_hash")
  hash           String?
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_log")
}

model ModelCall {
  id               String          @id @default(uuid()) @db.Uuid
  agentId          String          @map("agent_id") @db.Uuid
  ticketId         String?         @map("ticket_id") @db.Uuid
  conversationId   String?         @map("conversation_id") @db.Uuid
  provider         String
  model            String
  promptTokens     Int             @map("prompt_tokens")
  completionTokens Int             @map("completion_tokens")
  costEstimate     Decimal         @map("cost_estimate") @db.Decimal(12, 6)
  latencyMs        Int             @default(0) @map("latency_ms")
  status           ModelCallStatus @default(ok)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz

  agent        Agent         @relation(fields: [agentId], references: [id])
  ticket       Ticket?       @relation(fields: [ticketId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@map("model_calls")
}

model ToolCall {
  id             String         @id @default(uuid()) @db.Uuid
  agentId        String         @map("agent_id") @db.Uuid
  ticketId       String?        @map("ticket_id") @db.Uuid
  conversationId String?        @map("conversation_id") @db.Uuid
  connectorId    String?        @map("connector_id") @db.Uuid
  toolName       String         @map("tool_name")
  status         ToolCallStatus
  argsMeta       Json           @default("{}") @map("args_meta")
  resultMeta     Json?          @map("result_meta")
  latencyMs      Int            @map("latency_ms")
  policyDecision String?        @map("policy_decision")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  agent        Agent         @relation(fields: [agentId], references: [id])
  ticket       Ticket?       @relation(fields: [ticketId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  connector    Connector?    @relation(fields: [connectorId], references: [id])

  @@map("tool_calls")
}

// ── CR-MVP-001: A0 sandbox app registry ────────────────────────────────────

model SandboxApp {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String?               @map("tenant_id") @db.Uuid
  sandboxId   String?               @map("sandbox_id") @db.Uuid

  name        String
  description String?
  level       SandboxAppLevel       @default(A0)
  type        SandboxAppType        @default(single_html)
  status      SandboxAppStatus      @default(draft)
  criticality SandboxAppCriticality @default(L1)

  activeVersionId String? @map("active_version_id") @db.Uuid

  createdByType            SandboxCreatedByType @map("created_by_type")
  createdByUserId          String?              @map("created_by_user_id") @db.Uuid
  createdByAgentId         String?              @map("created_by_agent_id") @db.Uuid
  createdFromTicketId      String?              @map("created_from_ticket_id") @db.Uuid
  createdFromConversationId String?             @map("created_from_conversation_id") @db.Uuid

  policy Json @default("{}")
  tags   Json @default("[]")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  versions SandboxAppVersion[]

  @@index([tenantId, status])
  @@index([tenantId, sandboxId])
  @@index([tenantId, createdFromTicketId])
  @@map("sandbox_apps")
}

model SandboxAppVersion {
  id       String                  @id @default(uuid()) @db.Uuid
  tenantId String?                 @map("tenant_id") @db.Uuid
  appId    String                  @map("app_id") @db.Uuid

  version       Int
  status        SandboxAppVersionStatus @default(draft)
  changeSummary String                  @map("change_summary")

  artifactRef      String @map("artifact_ref")
  artifactSizeBytes Int   @map("artifact_size_bytes")
  contentHash      String @map("content_hash")
  mimeType         String @default("text/html; charset=utf-8") @map("mime_type")

  createdByType    SandboxCreatedByType @map("created_by_type")
  createdByUserId  String?              @map("created_by_user_id") @db.Uuid
  createdByAgentId String?              @map("created_by_agent_id") @db.Uuid
  createdFromRunId String?              @map("created_from_run_id") @db.Uuid
  sourceTicketId   String?              @map("source_ticket_id") @db.Uuid

  validationResult Json @default("{}") @map("validation_result")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  app          SandboxApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  sourceTicket Ticket?    @relation(fields: [sourceTicketId], references: [id])

  @@unique([appId, version])
  @@unique([tenantId, appId, contentHash])
  @@index([sourceTicketId])
  @@map("sandbox_app_versions")
}

// ── Fázis 2: Write-gate token ──────────────────────────────────────────────

enum WriteGateTokenStatus {
  issued
  consumed
  expired
  revoked
}

model WriteGateToken {
  id               String               @id @default(uuid()) @db.Uuid
  trainingTicketId String               @map("training_ticket_id") @db.Uuid
  agentId          String               @map("agent_id") @db.Uuid
  targetMemoryId   String               @map("target_memory_id") @db.Uuid
  expectedDiffHash String               @map("expected_diff_hash")
  tokenHash        String               @map("token_hash")
  signature        String
  status           WriteGateTokenStatus @default(issued)
  issuedAt         DateTime             @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz
  consumedAt       DateTime?            @map("consumed_at") @db.Timestamptz

  trainingTicket Ticket @relation(fields: [trainingTicketId], references: [id], onDelete: Cascade)
  agent          Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  targetMemory   Memory @relation(fields: [targetMemoryId], references: [id], onDelete: Cascade)

  @@map("write_gate_tokens")
}

// ── §4.4: tanítási ticket first-class metaadata (a write-gate köti) ─────────

model TrainingTicket {
  ticketId            String  @id @map("ticket_id") @db.Uuid
  proposedDiff        Json    @map("proposed_diff")
  writeGateTokenRef   String? @map("write_gate_token_ref")
  evalResult          Json?   @map("eval_result")
  targetMemoryVersion Int     @map("target_memory_version")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("training_tickets")
}

// ── Fázis 2: Eval-kapu ────────────────────────────────────────────────────

enum EvalStatus {
  active
  retired
}

enum EvalRunTrigger {
  pre_training_approval
  scheduled
  manual
}

model Eval {
  id        String     @id @default(uuid()) @db.Uuid
  agentId   String     @map("agent_id") @db.Uuid
  name      String
  goldenSet Json       @map("golden_set")
  status    EvalStatus @default(active)

  agent Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs  EvalRun[]

  @@map("evals")
}

model EvalRun {
  id              String         @id @default(uuid()) @db.Uuid
  evalId          String         @map("eval_id") @db.Uuid
  trigger         EvalRunTrigger
  agentVersion    Int            @map("agent_version")
  memoryVersionId String?        @map("memory_version_id") @db.Uuid
  passed          Boolean
  score           Float
  details         Json
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  eval          Eval           @relation(fields: [evalId], references: [id], onDelete: Cascade)
  memoryVersion MemoryVersion? @relation(fields: [memoryVersionId], references: [id])

  @@map("eval_runs")
}

/// Globális, runtime-állítható platform-beállítások (kulcs-érték). Pl. a dispatcher
/// kill-switch és poll-intervallum, amit a felhős worker minden ciklusban újraolvas.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}
