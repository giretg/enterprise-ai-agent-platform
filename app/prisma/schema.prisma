generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  approver
  operator
  viewer
}

enum UserStatus {
  pending
  active
  suspended
}

enum InvitationStatus {
  pending
  redeemed
  expired
  revoked
}

enum TenantStatus {
  active
  suspended
  offboarding
  archived
}

enum TenantMembershipStatus {
  pending
  active
  suspended
}

enum PlatformRole {
  superadmin
  platform_operator
  platform_auditor
}

enum PlatformMembershipStatus {
  active
  suspended
}

enum AuditActorType {
  human
  agent
  system
}

enum ResourceGrantType {
  agent
}

enum ResourceAccessLevel {
  view
  operate
}

enum AgentStatus {
  draft
  active
  suspended
  retired
}

enum MemoryWriteMode {
  approval
  direct
}

enum ProjectMemoryKind {
  decision
  open_task
  finding
  constraint
  artifact
  handoff_summary
  focus
  session_log
}

enum ProjectMemoryStatus {
  active
  superseded
}

enum HandoffStatus {
  open
  accepted
  done
  rejected
}

enum ConnectorType {
  google_drive
  http_api
  gmail
  knowledge_base
  code_sandbox
}

enum DocumentStatus {
  uploaded
  processed
  failed
}

enum KnowledgeProcessingMode {
  raw_text_only
  okf
}

enum KnowledgeArtifactStatus {
  pending_review
  published
  failed
}

enum KnowledgeArtifactFormat {
  okf
}

enum ConnectorAuthMode {
  service
  user_delegated
  agent_owned
}

enum ConnectorGrantStatus {
  active
  revoked
  expired
}

enum ConnectorScope {
  global
  single
}

enum ConnectorAccessMode {
  read
  write
}

enum ConnectorLifecycleState {
  draft
  validated
  active
  archived
  blocked

  @@map("connector_lifecycle_state")
}

enum ConnectorMode {
  fixed
  self_updating

  @@map("connector_mode")
}

enum ConnectorSpecVersionStatus {
  proposed
  approved
  superseded
  rejected
  rolled_back

  @@map("connector_spec_version_status")
}

enum ConnectorDraftSourceType {
  api_doc
  openapi
  manual
  template

  @@map("connector_draft_source_type")
}

enum ConnectorTemplateOrigin {
  builtin
  custom

  @@map("connector_template_origin")
}

enum ConnectorTemplateStatus {
  active
  deprecated
  archived

  @@map("connector_template_status")
}

enum ConnectorDraftReviewStatus {
  pending
  changes_requested
  approved
  rejected

  @@map("connector_draft_review_status")
}

enum SkillCatalogScope {
  global
  tenant
}

enum SkillKind {
  tenant
  published
  system
}

enum SkillSourceType {
  authored
  imported
}

enum SkillRiskTier {
  t0
  t1
  t2
  t3
}

enum SkillVersionStatus {
  proposed
  approved
  active
  retired
  rolled_back
}

enum ConversationSkillProposalStatus {
  open
  rejected
  approved

  @@map("conversation_skill_proposal_status")
}

enum ContactInquiryStatus {
  new
  reviewed

  @@map("contact_inquiry_status")
}

enum GatewayOperationStatus {
  requested
  awaiting_approval
  approved
  rejected
  executing
  succeeded
  failed
}

enum GatewayApprovalDecision {
  pending
  approved
  rejected
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  externalAuthId  String     @unique @map("external_auth_id")
  email           String
  name            String
  role            UserRole?
  status          UserStatus @default(pending) @map("status")
  invitedById     String?    @map("invited_by") @db.Uuid
  activatedAt     DateTime?  @map("activated_at") @db.Timestamptz
  suspendedAt     DateTime?  @map("suspended_at") @db.Timestamptz
  suspendedById   String?    @map("suspended_by") @db.Uuid
  suspendedReason String?    @map("suspended_reason")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  invitedBy                   User?                 @relation("UserInvitedBy", fields: [invitedById], references: [id])
  invitedUsers                User[]                @relation("UserInvitedBy")
  suspendedBy                 User?                 @relation("UserSuspendedBy", fields: [suspendedById], references: [id])
  suspendedUsers              User[]                @relation("UserSuspendedBy")
  approvedSkillVersions       SkillVersion[]        @relation("SkillApprovedBy")
  conversationSkillsRequested ConversationSkillProposal[] @relation("ConversationSkillRequestedBy")
  conversationSkillsDecided   ConversationSkillProposal[] @relation("ConversationSkillDecidedBy")
  createdInvitations          Invitation[]          @relation("InvitationCreatedBy")
  connectorGrants             ConnectorGrant[]
  resourceGrantsReceived      ResourceGrant[]       @relation("ResourceGrantUser")
  resourceGrantsIssued        ResourceGrant[]       @relation("ResourceGrantGrantedBy")
  tenantMemberships           TenantMembership[]    @relation("MembershipUser")
  membershipsInvited          TenantMembership[]    @relation("MembershipInvitedBy")
  platformMemberships         PlatformMembership[]  @relation("PlatformMembershipUser")
  tenantsCreated              Tenant[]              @relation("TenantCreatedBy")
  publishedDefinitions        AgentDefinitionVersion[] @relation("DefinitionPublishedBy")
  gatewayOperations           GatewayOperation[]    @relation("GatewayOperationPrincipal")
  gatewayApprovalsDecided     GatewayApproval[]     @relation("GatewayApprovalDecidedBy")
  uploadedDocuments           Document[]            @relation("DocumentUploadedBy")
  workProjectsCreated         WorkProject[]         @relation("WorkProjectCreatedBy")
  workFilesWritten            WorkFile[]            @relation("WorkFileLastWriter")
  projectMemoryItems          ProjectMemoryItem[]   @relation("ProjectMemoryWithUser")
  handoffsCreated             Handoff[]             @relation("HandoffCreatedBy")
  handoffsReceived            Handoff[]             @relation("HandoffToUser")
  reviewedContactInquiries     ContactInquiry[]       @relation("ContactInquiryReviewedBy")

  @@index([status])
  @@map("users")
}

model Invitation {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String?          @map("tenant_id") @db.Uuid
  clerkInvitationId String?          @unique @map("clerk_invitation_id")
  email             String
  role              UserRole
  tokenHash         String           @unique @map("token_hash")
  status            InvitationStatus @default(pending)
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz
  redeemedAt        DateTime?        @map("redeemed_at") @db.Timestamptz
  revokedAt         DateTime?        @map("revoked_at") @db.Timestamptz
  createdById       String           @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant? @relation(fields: [tenantId], references: [id])
  createdBy User    @relation("InvitationCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, status])
  @@map("invitations")
}

model ContactInquiry {
  id           String               @id @default(uuid()) @db.Uuid
  name         String
  phone        String
  email        String
  message      String               @db.Text
  status       ContactInquiryStatus @default(new)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  reviewedAt   DateTime?            @map("reviewed_at") @db.Timestamptz
  reviewedById String?              @map("reviewed_by_id") @db.Uuid

  reviewedBy User? @relation("ContactInquiryReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("contact_inquiries")
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique
  displayName     String       @map("display_name")
  legalName       String?      @map("legal_name")
  status          TenantStatus @default(active)
  domainAllowlist Json         @default("[]") @map("domain_allowlist")
  settings        Json         @default("{}")
  createdById     String?      @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  createdBy         User?              @relation("TenantCreatedBy", fields: [createdById], references: [id])
  memberships       TenantMembership[]
  invitations       Invitation[]
  agents            Agent[]
  skills            Skill[]
  conversationSkillProposals ConversationSkillProposal[]
  connectors        Connector[]
  connectorGrants   ConnectorGrant[]
  connectorDrafts   ConnectorDraft[]
  connectorTemplates ConnectorTemplate[]
  resourceGrants    ResourceGrant[]
  gatewayOperations GatewayOperation[]
  auditLogs         AuditLog[]
  documents         Document[]
  workProjects      WorkProject[]
  workFiles         WorkFile[]
  projectMemoryItems ProjectMemoryItem[]
  handoffs          Handoff[]
  clientPolicies    ClientPolicy[]

  @@index([status])
  @@map("tenants")
}

model TenantMembership {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  role        UserRole
  status      TenantMembershipStatus @default(pending)
  isDefault   Boolean                @default(false) @map("is_default")
  invitedById String?                @map("invited_by") @db.Uuid
  activatedAt DateTime?              @map("activated_at") @db.Timestamptz
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  user      User   @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("MembershipInvitedBy", fields: [invitedById], references: [id])

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, role, status])
  @@map("tenant_memberships")
}

model PlatformMembership {
  id        String                   @id @default(uuid()) @db.Uuid
  userId    String                   @map("user_id") @db.Uuid
  role      PlatformRole
  status    PlatformMembershipStatus @default(active)
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation("PlatformMembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, status])
  @@map("platform_memberships")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  permissionKey String   @unique @map("permission_key")
  minRole       UserRole @map("min_role")
  description   String?
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("role_permissions")
}

model ResourceGrant {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  resourceType ResourceGrantType   @map("resource_type")
  resourceId   String              @map("resource_id") @db.Uuid
  accessLevel  ResourceAccessLevel @map("access_level")
  grantedById  String              @map("granted_by") @db.Uuid
  grantedAt    DateTime            @default(now()) @map("granted_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("ResourceGrantUser", fields: [userId], references: [id])
  grantedBy User   @relation("ResourceGrantGrantedBy", fields: [grantedById], references: [id])

  @@unique([tenantId, userId, resourceType, resourceId])
  @@index([tenantId, userId])
  @@index([tenantId, resourceId])
  @@map("resource_grants")
}

model Agent {
  id                         String      @id @default(uuid()) @db.Uuid
  tenantId                   String      @map("tenant_id") @db.Uuid
  name                       String
  roleInstruction            String      @map("role_instruction")
  /** Megszeghetetlen szabályok — soronként egy bejegyzés; publikáláskor befagy a snapshot.rules-ba. */
  hardRules                  String      @default("") @map("hard_rules")
  /** Jóváhagyott betanított működési szabályok; új tanítás csak újrapublikáláskor érvényes MCP-n. */
  trainedRules               String      @default("") @map("trained_rules")
  description                String?
  status                     AgentStatus @default(draft)
  currentDefinitionVersionId String?     @unique @map("current_definition_version_id") @db.Uuid
  avatarUrl                  String?     @map("avatar_url")
  memoryWriteMode            MemoryWriteMode @default(approval) @map("memory_write_mode")
  /** Céges HTTP API írás (http_api_request): jóváhagyás vagy azonnali. */
  httpApiWriteMode           MemoryWriteMode @default(approval) @map("http_api_write_mode")
  /** Gmail írás (küldés, piszkozat, címke, kuka). */
  gmailWriteMode             MemoryWriteMode @default(approval) @map("gmail_write_mode")
  /** Drive / Sheets írás. Az output-mappa ettől függetlenül marad kivétel. */
  driveWriteMode             MemoryWriteMode @default(approval) @map("drive_write_mode")
  /** Megnevezett jóváhagyó (#663): a tenant egyik usere; az írások elsősorban hozzá kerülnek. */
  approverUserId             String?         @map("approver_user_id") @db.Uuid
  /** Agent saját Drive output-mappája (#661): ide a feltöltés jóváhagyás nélkül, auditáltan fut. */
  outputDriveFolderId        String?         @map("output_drive_folder_id")
  /** Helyi kódmappa-hint (#729): soronként egy jelölt ~/… vagy abszolút path (több gép); publikáláskor a snapshotba. */
  localRoots                 String          @default("") @map("local_roots")
  createdAt                  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  retiredAt                  DateTime?   @map("retired_at") @db.Timestamptz

  tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  currentDefinition AgentDefinitionVersion?  @relation("AgentCurrentDefinition", fields: [currentDefinitionVersionId], references: [id], onDelete: SetNull)
  definitionVersions AgentDefinitionVersion[] @relation("AgentDefinitionHistory")
  agentConnectors   AgentConnector[]
  capabilities      Capability[]
  agentSkills       AgentSkill[]
  conversationSkillProposals ConversationSkillProposal[]
  projectMemoryItems ProjectMemoryItem[]
  handoffsSent     Handoff[] @relation("HandoffFromAgent")
  handoffsReceived Handoff[] @relation("HandoffToAgent")

  @@index([tenantId, status])
  @@map("agents")
}

model AgentDefinitionVersion {
  id            String   @id @default(uuid()) @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  version       Int
  snapshot      Json
  contentHash   String   @map("content_hash")
  publishedById String   @map("published_by") @db.Uuid
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz

  agent         Agent               @relation("AgentDefinitionHistory", fields: [agentId], references: [id], onDelete: Cascade)
  publishedBy   User                @relation("DefinitionPublishedBy", fields: [publishedById], references: [id])
  currentForAgent Agent?            @relation("AgentCurrentDefinition")
  gatewayOperations GatewayOperation[]

  @@unique([agentId, version])
  @@map("agent_definition_versions")
}

model Skill {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  displayName  String?           @map("display_name")
  description  String
  catalogScope SkillCatalogScope @default(tenant)
  tenantId     String?           @map("tenant_id") @db.Uuid
  kind         SkillKind         @default(tenant)
  sourceType   SkillSourceType   @default(authored)
  provenance   Json?
  license      String?
  riskTier     SkillRiskTier
  producesSkills Boolean         @default(false) @map("produces_skills")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant?        @relation(fields: [tenantId], references: [id])
  versions SkillVersion[]
  conversationProposals ConversationSkillProposal[]

  @@index([tenantId])
  @@map("skills")
}

model SkillVersion {
  id           String             @id @default(uuid()) @db.Uuid
  skillId      String             @map("skill_id") @db.Uuid
  version      Int
  content      Json
  requires     Json
  attachments  Json?
  status       SkillVersionStatus @default(proposed)
  contentHash  String             @map("content_hash")
  approvedById String?            @map("approved_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  approvedBy  User?        @relation("SkillApprovedBy", fields: [approvedById], references: [id])
  agentSkills AgentSkill[]

  @@unique([skillId, version])
  @@map("skill_versions")
}

model AgentSkill {
  agentId        String   @map("agent_id") @db.Uuid
  skillVersionId String   @map("skill_version_id") @db.Uuid
  enabled        Boolean  @default(true)
  /// Belépő (orkesztráló) skill: minden új feladat ezzel indul. Agentenként legfeljebb egy (részleges unique index a migrációban).
  entry          Boolean  @default(false)
  assignedById   String?  @map("assigned_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillVersion SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)

  @@id([agentId, skillVersionId])
  @@map("agent_skills")
}

model ConversationSkillProposal {
  id            String                          @id @default(uuid()) @db.Uuid
  tenantId      String                          @map("tenant_id") @db.Uuid
  agentId       String                          @map("agent_id") @db.Uuid
  requestedById String                          @map("requested_by") @db.Uuid
  name          String
  description   String
  content       Json
  requires      Json
  attachments   Json?
  status        ConversationSkillProposalStatus @default(open)
  createdAt     DateTime                        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                        @updatedAt @map("updated_at") @db.Timestamptz
  decidedAt     DateTime?                       @map("decided_at") @db.Timestamptz
  decidedById   String?                         @map("decided_by") @db.Uuid
  skillId       String?                         @map("skill_id") @db.Uuid

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent       Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("ConversationSkillRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?  @relation("ConversationSkillDecidedBy", fields: [decidedById], references: [id])
  skill       Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([agentId, requestedById, status])
  @@map("conversation_skill_proposals")
}

model Connector {
  id             String                  @id @default(uuid()) @db.Uuid
  type           ConnectorType
  name           String
  authMode       ConnectorAuthMode       @default(service) @map("auth_mode")
  scope          ConnectorScope
  secretAlias    String?                 @map("secret_alias")
  version        Int                     @default(1)
  config         Json                    @default("{}")
  lifecycleState ConnectorLifecycleState @default(active) @map("lifecycle_state")
  tenantId       String                  @map("tenant_id") @db.Uuid
  /** Megnevezett jóváhagyó (#663): az agent-szintűt felülírja. */
  approverUserId String?                 @map("approver_user_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz

  connectorMode       ConnectorMode          @default(fixed) @map("connector_mode")
  activeSpecVersionId String?                @map("active_spec_version_id") @db.Uuid
  activeSpecVersion   ConnectorSpecVersion?  @relation("ActiveSpecVersion", fields: [activeSpecVersionId], references: [id], onDelete: SetNull)

  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  agentConnectors   AgentConnector[]
  grants            ConnectorGrant[]
  draft             ConnectorDraft?
  gatewayOperations GatewayOperation[]
  specSource        ConnectorSpecSource?
  specVersions      ConnectorSpecVersion[] @relation("SpecVersions")
  documents         Document[]
  knowledgeArtifacts KnowledgeArtifact[]
  knowledgeChunks   KnowledgeChunk[]

  @@unique([tenantId, type, name])
  @@map("connectors")
}

model ConnectorTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  key         String
  version     Int                     @default(1)
  origin      ConnectorTemplateOrigin @default(custom)
  displayName String                  @map("display_name")
  description String?
  tenantId    String?                 @map("tenant_id") @db.Uuid
  descriptor  Json
  status      ConnectorTemplateStatus @default(active)
  createdById String?                 @map("created_by") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([key, version, tenantId])
  @@index([origin, status])
  @@map("connector_templates")
}

model ConnectorDraft {
  id                      String                     @id @default(uuid()) @db.Uuid
  tenantId                String                     @map("tenant_id") @db.Uuid
  connectorId             String                     @unique @map("connector_id") @db.Uuid
  sourceType              ConnectorDraftSourceType   @map("source_type")
  sourceRef               String?                    @map("source_ref")
  sourceHash              String                     @map("source_hash")
  generatedByAgentId      String?                    @map("generated_by_agent_id") @db.Uuid
  validationResult        Json?                      @map("validation_result")
  reviewStatus            ConnectorDraftReviewStatus @default(pending) @map("review_status")
  reviewedById            String?                    @map("reviewed_by") @db.Uuid
  secondApproverId        String?                    @map("second_approver_id") @db.Uuid
  sandboxTestOk           Boolean?                   @map("sandbox_test_ok")
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, connectorId])
  @@map("connector_drafts")
}

model ConnectorSpecSource {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  connectorId       String    @unique @map("connector_id") @db.Uuid
  connector         Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  specUrl           String    @map("spec_url")
  specFormat        String    @default("openapi_3") @map("spec_format")
  urlApprovedById   String?   @map("url_approved_by") @db.Uuid
  urlApprovedAt     DateTime? @map("url_approved_at") @db.Timestamptz
  trustedById       String?   @map("trusted_by") @db.Uuid
  trustedAt         DateTime? @map("trusted_at") @db.Timestamptz
  autoApprovePolicy Json?     @map("auto_approve_policy")
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamptz
  createdById       String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("connector_spec_sources")
}

model ConnectorSpecVersion {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String                     @map("tenant_id") @db.Uuid
  connectorId       String                     @map("connector_id") @db.Uuid
  connector         Connector                  @relation("SpecVersions", fields: [connectorId], references: [id], onDelete: Cascade)
  versionNo         Int                        @map("version_no")
  rawSnapshot       Json                       @map("raw_snapshot")
  rawHash           String                     @map("raw_hash")
  capabilitySet     Json                       @map("capability_set")
  status            ConnectorSpecVersionStatus @default(proposed)
  diffFromVersionId String?                    @map("diff_from_version_id") @db.Uuid
  diffSummary       Json?                      @map("diff_summary")
  fetchedAt         DateTime                   @default(now()) @map("fetched_at") @db.Timestamptz
  approvedById      String?                    @map("approved_by") @db.Uuid
  approvedAt        DateTime?                  @map("approved_at") @db.Timestamptz
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  activeForConnectors Connector[] @relation("ActiveSpecVersion")

  @@unique([connectorId, versionNo])
  @@index([connectorId, status])
  @@map("connector_spec_versions")
}

model ConnectorGrant {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  connectorId     String               @map("connector_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  status          ConnectorGrantStatus @default(active)
  scopes          Json                 @default("[]")
  tokenRef        String               @unique @map("token_ref")
  accountLabel    String?              @map("account_label")
  grantedAt       DateTime             @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt       DateTime?            @map("expires_at") @db.Timestamptz
  lastRefreshedAt DateTime?            @map("last_refreshed_at") @db.Timestamptz
  revokedAt       DateTime?            @map("revoked_at") @db.Timestamptz
  metadata        Json                 @default("{}")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, connectorId, userId])
  @@map("connector_grants")
}

model AgentConnector {
  agentId     String              @map("agent_id") @db.Uuid
  connectorId String              @map("connector_id") @db.Uuid
  accessMode  ConnectorAccessMode @map("access_mode")

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@id([agentId, connectorId])
  @@map("agent_connectors")
}

model Capability {
  agentId   String   @map("agent_id") @db.Uuid
  toolName  String   @map("tool_name")
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, toolName])
  @@map("capabilities")
}

model Document {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantId        String                    @map("tenant_id") @db.Uuid
  filename        String
  storageRef      String?                   @map("storage_ref")
  extractedText   String?                   @map("extracted_text") @db.Text
  mimeType        String?                   @map("mime_type")
  contentHash     String?                   @map("content_hash")
  status          DocumentStatus            @default(uploaded)
  processingMode  KnowledgeProcessingMode?  @map("processing_mode")
  metadata        Json                      @default("{}")
  connectorId     String?                   @map("connector_id") @db.Uuid
  uploadedById    String                    @map("uploaded_by") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  connector  Connector?           @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  uploadedBy User                 @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  artifacts  KnowledgeArtifact[]

  @@index([tenantId, connectorId])
  @@map("documents")
}

model KnowledgeArtifact {
  id               String                   @id @default(uuid()) @db.Uuid
  connectorId      String                   @map("connector_id") @db.Uuid
  sourceDocumentId String?                  @map("source_document_id") @db.Uuid
  createdByAgentId String?                  @map("created_by_agent_id") @db.Uuid
  status           KnowledgeArtifactStatus  @default(pending_review)
  format           KnowledgeArtifactFormat  @default(okf)
  version          Int                      @default(1)
  contentHash      String                   @map("content_hash")
  bundle           Json                     @default("{}")
  validationResult Json?                    @map("validation_result")
  publishedAt      DateTime?                @map("published_at") @db.Timestamptz
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  connector      Connector         @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  sourceDocument Document?         @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  chunks         KnowledgeChunk[]

  @@index([connectorId, status])
  @@map("knowledge_artifacts")
}

model KnowledgeChunk {
  id          String   @id @default(uuid()) @db.Uuid
  artifactId  String   @map("artifact_id") @db.Uuid
  connectorId String   @map("connector_id") @db.Uuid
  path        String
  title       String
  type        String
  section     String?
  chunkIndex  Int      @map("chunk_index")
  text        String   @db.Text
  sourceRef   Json?    @map("source_ref")
  contentHash String   @map("content_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  artifact  KnowledgeArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  connector Connector         @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@index([artifactId, path])
  @@map("knowledge_chunks")
}

model WorkProject {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User   @relation("WorkProjectCreatedBy", fields: [createdById], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId, archivedAt])
  @@map("work_projects")
}

model WorkFile {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  projectKey       String   @map("project_key")
  path             String
  content          String   @db.Text
  byteSize         Int      @map("byte_size")
  lastWriterUserId String   @map("last_writer_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  lastWriter User   @relation("WorkFileLastWriter", fields: [lastWriterUserId], references: [id])

  @@unique([tenantId, projectKey, path])
  @@index([tenantId, projectKey])
  @@map("work_files")
}

model ProjectMemoryItem {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  agentId      String               @map("agent_id") @db.Uuid
  projectKey   String               @map("project_key")
  kind         ProjectMemoryKind
  title        String
  body         String               @db.Text
  artifactPath String?              @map("artifact_path")
  withUserId   String               @map("with_user_id") @db.Uuid
  status       ProjectMemoryStatus  @default(active)
  supersedesId String?              @map("supersedes_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  agent      Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  withUser   User                @relation("ProjectMemoryWithUser", fields: [withUserId], references: [id])
  supersedes ProjectMemoryItem?  @relation("ProjectMemorySupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy ProjectMemoryItem[] @relation("ProjectMemorySupersedes")

  @@index([tenantId, agentId, projectKey, status])
  @@index([withUserId])
  @@map("project_memory_items")
}

model GatewayOperation {
  id                        String                 @id @default(uuid()) @db.Uuid
  tenantId                  String                 @map("tenant_id") @db.Uuid
  agentDefinitionVersionId  String                 @map("agent_definition_version_id") @db.Uuid
  principalUserId           String                 @map("principal_user_id") @db.Uuid
  toolName                  String                 @map("tool_name")
  argsJson                  Json                   @map("args_json")
  idempotencyKey            String                 @map("idempotency_key")
  status                    GatewayOperationStatus
  connectorId               String?                @map("connector_id") @db.Uuid
  /** #663: enqueue-kori pillanatkép a megnevezett jóváhagyóról (konnektor > agent). */
  designatedApproverUserId  String?                @map("designated_approver_user_id") @db.Uuid
  designatedApproverName    String?                @map("designated_approver_name")
  errorCode                 String?                @map("error_code")
  resultJson                Json?                  @map("result_json")
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant                 @relation(fields: [tenantId], references: [id])
  definition AgentDefinitionVersion @relation(fields: [agentDefinitionVersionId], references: [id])
  principal  User                   @relation("GatewayOperationPrincipal", fields: [principalUserId], references: [id])
  connector  Connector?             @relation(fields: [connectorId], references: [id])
  approval   GatewayApproval?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("gateway_operations")
}

model GatewayApproval {
  id              String                   @id @default(uuid()) @db.Uuid
  operationId     String                   @unique @map("operation_id") @db.Uuid
  decidedByUserId String?                  @map("decided_by_user_id") @db.Uuid
  decision        GatewayApprovalDecision  @default(pending)
  reason          String?
  decidedAt       DateTime?                @map("decided_at") @db.Timestamptz
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  operation GatewayOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  decidedBy User?            @relation("GatewayApprovalDecidedBy", fields: [decidedByUserId], references: [id])

  @@map("gateway_approvals")
}

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  seq            BigInt         @unique @default(autoincrement())
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Uuid
  agentVersion   Int?           @map("agent_version")
  action         String
  targetType     String         @map("target_type")
  targetId       String?        @map("target_id") @db.Uuid
  modelUsed      String?        @map("model_used")
  inputRef       String?        @map("input_ref")
  outputRef      String?        @map("output_ref")
  policyDecision String?        @map("policy_decision")
  prevHash       String?        @map("prev_hash")
  hash           String?
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  tenantId       String?        @map("tenant_id") @db.Uuid

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

model Handoff {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  fromAgentId      String        @map("from_agent_id") @db.Uuid
  fromDefinitionId String        @map("from_definition_id") @db.Uuid
  toAgentId        String?       @map("to_agent_id") @db.Uuid
  toUserId         String?       @map("to_user_id") @db.Uuid
  projectKey       String        @map("project_key")
  title            String
  summary          String        @db.Text
  links            String?
  status           HandoffStatus @default(open)
  memoryId         String?       @map("memory_id") @db.Uuid
  createdById      String        @map("created_by_id") @db.Uuid
  decidedById      String?       @map("decided_by_id") @db.Uuid
  decidedAt        DateTime?     @map("decided_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  fromAgent Agent  @relation("HandoffFromAgent", fields: [fromAgentId], references: [id], onDelete: Cascade)
  toAgent   Agent? @relation("HandoffToAgent", fields: [toAgentId], references: [id], onDelete: Cascade)
  toUser    User?  @relation("HandoffToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  createdBy User   @relation("HandoffCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, toAgentId, status])
  @@index([tenantId, toUserId, status])
  @@map("handoffs")
}

/// Hermes Managed Client policy (#746 V1-1): a tenant/user/agent szintű paraméterezés forrás-igazsága.
/// `scopeId` polimorf (tenant → tenantId, user → users.id, agent → agents.id), ezért nincs rá FK.
model ClientPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  scope         String
  scopeId       String   @map("scope_id") @db.Uuid
  preset        String?
  capabilities  Json     @default("{}")
  toolOverrides Json     @default("{}") @map("tool_overrides")
  version       Int      @default(1)
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, scopeId])
  @@map("client_policies")
}
