  single
}

enum RecipeVersionStatus {
  proposed
  active
  retired
}

// ── Skill-katalógus (spec: skill-catalog-spec.md) ───────────────────────────
// Importálható/szerezhető, governance alá vont agent-skillek. A skill puha része
// (instrukciók) promptba injektálva; a kemény része (`requires` capability-manifeszt)
// a Tool Brokerrel kikényszerítve. Fázis 1: kizárólag T0/T1 (instrukció-only).
enum SkillCatalogScope {
  global // admin-kurált, tenantoknak read-only
  tenant // tenant-lokális, más tenantnak sosem látható
}

enum SkillSourceType {
  authored
  imported
}

enum SkillRiskTier {
  t0 // csak instrukció, nincs tool-igény, nincs kód
  t1 // instrukció + tool-igény, nincs kód
  t2 // kód, nincs egress/secret (Fázis 2)
  t3 // kód + háló/secret (Fázis 2)
}

