/// #640 ütemezett feladat: a platform a kanonikus példány, a harness a saját natív
/// ütemezőjében egy vékony csonkot futtat, ami `platform.scheduled_task.run_start`-ot hív.
model ScheduledTask {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  agentId          String                @map("agent_id") @db.Uuid
  /// Egyéni feladatnál akinek a nevében fut; csapat/megosztott feladatnál aki szerkesztheti.
  ownerUserId      String                @map("owner_user_id") @db.Uuid
  kind             ScheduledTaskKind     @default(personal)
  createdById      String                @map("created_by") @db.Uuid
  title            String
  instruction      String                @db.Text
  /// 5 mezős cron, a `timezone`-ban értve.
  cron             String
  timezone         String
  graceMinutes     Int?                  @map("grace_minutes")
  targets          String[]
  audience         ScheduledTaskAudience @default(selected)
  ownerSeesResults Boolean               @default(false) @map("owner_sees_results")
  /// Minden szerkesztés +1; a tagok elfogadása (D15) ehhez a verzióhoz kötött.
  version          Int                   @default(1)
  scheduleHash     String                @map("schedule_hash")
  status           ScheduledTaskStatus   @default(active)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant                      @relation(fields: [tenantId], references: [id])
  agent         Agent                       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  owner         User                        @relation("ScheduledTaskOwner", fields: [ownerUserId], references: [id])
  installations ScheduledTaskInstallation[]
  members       ScheduledTaskMember[]
  runs          ScheduledTaskRun[]

  @@index([tenantId, ownerUserId, status])
  @@index([tenantId, agentId])
  @@map("scheduled_tasks")
}

model ScheduledTaskInstallation {
  id                    String    @id @default(uuid()) @db.Uuid
  taskId                String    @map("task_id") @db.Uuid
  /// Akinek a harness-ében telepítve van (csapat/megosztott feladatnál tagonként külön).
  userId                String    @map("user_id") @db.Uuid
  clientType            String    @map("client_type")
  clientInstanceId      String    @map("client_instance_id")
  externalId            String    @map("external_id")
  /// A háromutas összevetés alapja: amit legutóbb ténylegesen telepítettünk.
  installedScheduleHash String    @map("installed_schedule_hash")
  installedStubHash     String    @map("installed_stub_hash")
  installedVersion      Int       @map("installed_version")
  locallyDisabled       Boolean   @default(false) @map("locally_disabled")
  lastSeenAt            DateTime  @map("last_seen_at") @db.Timestamptz
  lastSyncAt            DateTime? @map("last_sync_at") @db.Timestamptz
  removedAt             DateTime? @map("removed_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  task ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, clientType, clientInstanceId, externalId])
  @@index([taskId, removedAt])
  @@index([userId, clientType, clientInstanceId])
  @@map("scheduled_task_installations")
}

/// Csapat- és megosztott feladat tagjai (a tulajdonos is tag), illetve egyéni feladatnál
/// a más által létrehozott feladat beleegyezése (K8).
model ScheduledTaskMember {
  id              String                   @id @default(uuid()) @db.Uuid
  taskId          String                   @map("task_id") @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  state           ScheduledTaskMemberState @default(invited)
  acceptedVersion Int?                     @map("accepted_version")
  invitedById     String                   @map("invited_by") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  task ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([userId, state])
  @@map("scheduled_task_members")
}

model ScheduledTaskRun {
  id                  String                 @id @default(uuid()) @db.Uuid
  taskId              String                 @map("task_id") @db.Uuid
  /// Szerver-számolt ütemezési időpont.
  slot                DateTime               @db.Timestamptz
  installationId      String?                @map("installation_id") @db.Uuid
  runnerUserId        String                 @map("runner_user_id") @db.Uuid
  /// Megosztott feladatnál a futtató userId-ja, egyébként "".
  claimKey            String                 @default("") @map("claim_key")
  taskVersion         Int                    @map("task_version")
  definitionVersionId String?                @map("definition_version_id") @db.Uuid
  status              ScheduledTaskRunStatus
  /// A futás indításakor elfogadott megosztás; korábbi privát eredményt nem tesz láthatóvá.
  ownerSeesResults    Boolean                @default(false) @map("owner_sees_results")
  catchUp             Boolean                @default(false) @map("catch_up")
  summary             String?                @db.Text
  startedAt           DateTime               @default(now()) @map("started_at") @db.Timestamptz
  finishedAt          DateTime?              @map("finished_at") @db.Timestamptz

  task ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// D4: egy időpont = egy futás (megosztottnál tagonként egy).
  @@unique([taskId, slot, claimKey])
  @@index([runnerUserId, status, startedAt])
  @@map("scheduled_task_runs")
}

/// Mini app láthatósága (#967 D11). `agents`: van aktív MiniAppShare; `organization` ettől függetlenül mindenkinek.
enum MiniAppVisibility {
  private
  agents
  organization
}

enum MiniAppStatus {
  active
  archived
}

/// Mini app (#967): agent által készített, statikus, egyfájlos HTML (A0). Az app az agenté (D3).
model MiniApp {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  ownerAgentId         String            @map("owner_agent_id") @db.Uuid
  projectKey           String            @map("project_key")
  name                 String
  description          String?
  status               MiniAppStatus     @default(active)
  visibility           MiniAppVisibility @default(private)
  currentVersion       Int               @map("current_version")
  copiedFromAppId      String?           @map("copied_from_app_id") @db.Uuid
  copiedFromVersion    Int?              @map("copied_from_version")
  /// A létrehozó hívás idempotencia-kulcsa (ismételt create = ugyanaz az app).
  createIdempotencyKey String?           @map("create_idempotency_key")
  createdByUserId      String            @map("created_by") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt           DateTime?         @map("archived_at") @db.Timestamptz

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  ownerAgent Agent            @relation(fields: [ownerAgentId], references: [id], onDelete: Cascade)
  versions   MiniAppVersion[]
  shares     MiniAppShare[]

  @@unique([tenantId, ownerAgentId, createIdempotencyKey])
  @@index([tenantId, ownerAgentId, status])
  @@index([tenantId, visibility, status])
  @@index([status, archivedAt])
  @@map("mini_apps")
}

/// Változatlan (immutable) mini app verzió; a HTML SOHA nem kerül auditba/logba.
model MiniAppVersion {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  appId           String   @map("app_id") @db.Uuid
  version         Int
  html            String   @db.Text
  /// sha256 hex, CRLF→LF normalizálás után.
  contentHash     String   @map("content_hash")
  byteSize        Int      @map("byte_size")
  lintWarnings    String[] @map("lint_warnings")
  changeNote      String?  @map("change_note")
  idempotencyKey  String?  @map("idempotency_key")
  createdByUserId String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  app MiniApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, version])
  @@unique([appId, idempotencyKey])
  @@map("mini_app_versions")
}

/// Megosztás konkrét agenttel (olvasás + másolat, D4). Visszavonás: revokedAt.
model MiniAppShare {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  appId          String    @map("app_id") @db.Uuid
  agentId        String    @map("agent_id") @db.Uuid
  sharedByUserId String    @map("shared_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz

  app   MiniApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  agent Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([appId, agentId])
  @@index([tenantId, agentId, revokedAt])
  @@map("mini_app_shares")
}

/// #984 AI-adattárház: melyik céghez melyik adattárház tartozik. Az üzleti adat,
/// a katalógus és az importok a tenant saját sémájában élnek, nem itt.
model TenantWarehouse {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @unique @map("tenant_id") @db.Uuid
  /// requested → provisioning → verifying → ready | failed
  status          String
  provisioner     String
  schemaName      String    @map("schema_name")
  internalVersion Int?      @map("internal_version")
  lastError       String?   @map("last_error")
  attempts        Int       @default(0)
  requestedById   String?   @map("requested_by") @db.Uuid
  readyAt         DateTime? @map("ready_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_warehouses")
}

/// #1016 nyilvános ügyfélszolgálati asszisztens profilja. A `draft`-ot a munkatárs szerkeszti, a látogató
/// mindig a `published` pillanatképet kapja (D16); a konfiguráció alakja: `src/domain/public-chat/config.ts`.
model PublicAssistant {
  agentId          String    @id @map("agent_id") @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  /// A nyilvános cím `/c/<slug>`; a szerver ebből oldja fel a tenantot és az agentet.
  slug             String    @unique
  draft            Json      @default("{}")
  published        Json?
  publishedAt      DateTime? @map("published_at") @db.Timestamptz
  publishedById    String?   @map("published_by") @db.Uuid
  /// D16: azonnali szünet — a látogató barátságos „nem elérhető” állapotot lát.
  paused           Boolean   @default(false)
  /// D21 állapotjelző: honnan és mikor töltötték be utoljára a widgetet / linket.
  lastLoadedDomain String?   @map("last_loaded_domain")
  lastLoadedAt     DateTime? @map("last_loaded_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  agent    Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions PublicChatSession[]

  @@index([tenantId])
  @@map("public_assistants")
}

/// #1016 D11/D17: egy névtelen látogató egy beszélgetése (`public_web` csatorna). 30 nap után törlődik.
model PublicChatSession {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  agentId        String    @map("agent_id") @db.Uuid
  /// A böngészőben tárolt névtelen látogató-azonosító (véletlen, ≥ 32 karakter) — a beszélgetés kulcsa is.
  visitorId      String    @map("visitor_id")
  /// D22: „Kipróbálás látogatóként” — az analitikán kívül.
  isTest         Boolean   @default(false) @map("is_test")
  /// D2/D3: a widget által átadott, MEGBÍZHATATLAN kontextus (≤ 8 kB).
  context        Json?
  /// [{ role: 'user' | 'assistant', content, at }]
  messages       Json      @default("[]")
  messageCount   Int       @default(0) @map("message_count")
  /// none | forwarded | callback_requested
  handoff        String    @default("none")
  handoffContact String?   @map("handoff_contact")
  handoffSummary String?   @map("handoff_summary")
  ipHash         String?   @map("ip_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assistant PublicAssistant    @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  signals   PublicChatSignal[]

  @@index([tenantId, agentId, lastActivityAt])
  @@index([agentId, visitorId])
  @@index([ipHash, createdAt])
  @@index([createdAt])
  @@map("public_chat_sessions")
}

/// #1016 D20: „Megválaszolatlan kérdések” jelzés — forrás: az agent „nem tudtam” eszköze, KB-találat hiánya, továbbítás.
model PublicChatSignal {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  agentId     String    @map("agent_id") @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  /// uncertain | no_kb_hit | forward
  source      String
  question    String
  /// A napi LLM-összefoglaló csoportja.
  groupLabel  String?   @map("group_label")
  /// A munkatárs válasz-javaslata a nyilvános KB-ba; admin jóváhagyásáig nem kerül be.
  answerDraft String?   @map("answer_draft")
  answeredAt  DateTime? @map("answered_at") @db.Timestamptz
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  session PublicChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentId, createdAt])
  @@map("public_chat_signals")
}

/// #1016 D14: a nyilvános chat napi modell-költése tenantonként, külön „nyilvános chat” gateway-sorként.
model PublicChatDailyUsage {
  tenantId  String   @map("tenant_id") @db.Uuid
  day       DateTime @db.Date
  costUsd   Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  calls     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, day])
  @@map("public_chat_daily_usage")
}
