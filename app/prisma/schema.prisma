// ── Feature-spec: Sandbox verziózás, test→live promóció, graduation (§3) ────
// A sandbox mint verziózott projekt. Kulcs-invariáns: a KÓD (commit-fa) és az
// ADAT (point-in-time snapshot) két külön sín; a go-live promóció ember-only
// kemény padló; a graduation-export ember-only, reprodukálható checksummal.

enum SandboxEnv {
  test
  live
