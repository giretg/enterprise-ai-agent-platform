# Neon Postgres — pooled kapcsolat (app / server actions)
# Neon Console → Connection Details → "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — direct kapcsolat (Prisma migrate / db push)
# Neon Console → Connection Details → "Direct connection"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Neon teszt branch (opcionális) — Neon Console → Branches → Create branch → connection strings
# Ha be van állítva, a /control-plane/system oldalon váltani lehet éles ↔ teszt között.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@ep-xxx-test-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL_TEST="postgresql://USER:PASSWORD@ep-xxx-test.region.aws.neon.tech/neondb?sslmode=require"
# Lokális induláskori alapértelmezés (admin felület felülírja runtime-ban):
# DATABASE_MODE=production

# Neon branch restore (opcionális, gyors éles→teszt szinkron a Rendszer oldalon)
# Neon Console → Account → API keys; Project Settings → project ID; Branches → branch ID-k (br-…)
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_PRODUCTION_BRANCH_ID=br-...   # éles (szülő) branch
# NEON_TEST_BRANCH_ID=br-...         # teszt (gyerek) branch

# Clerk (optional in dev — falls back to DevAuthProvider)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# RBAC: Clerk Dashboard → Users → Public metadata → { "role": "admin"|"approver"|"operator"|"viewer" }
# Webhook: Clerk Dashboard → Webhooks → endpoint /api/webhooks/clerk (user.created, user.updated)
CLERK_WEBHOOK_SIGNING_SECRET=

# ChatGPT OAuth Model Gateway adapter (S2)
# stub:  beépített acceptance/dev stub; vagy http://127.0.0.1:3101/v1/chat (npm run s2:stub)
# VALÓDI (élő ChatGPT OAuth mediáció): indítsd a sidecart `npm run s2:provider`,
#   majd: CHATGPT_OAUTH_PROVIDER_URL=http://127.0.0.1:3101/ és egy belső kulcs.
#   A sidecar a ~/.codex/auth.json „Sign in with ChatGPT" tokeneket használja
#   (szerveroldalon marad); a modell a CHATGPT_OAUTH_MODEL (default gpt-5.5).
CHATGPT_OAUTH_PROVIDER_URL=stub
CHATGPT_OAUTH_PROVIDER_KEY=stub
# CHATGPT_OAUTH_STUB=true
# CHATGPT_OAUTH_MODEL=gpt-5.5
# CODEX_AUTH_FILE=~/.codex/auth.json
# CHATGPT_OAUTH_PROVIDER_PORT=3101
#
# BEÁGYAZOTT (in-process) valódi mediáció — sidecar URL nélkül:
#   CHATGPT_OAUTH_EMBEDDED=true                      # lokálisan: ~/.codex/auth.json (CODEX_AUTH_FILE)
#   CHATGPT_OAUTH_TOKEN_SECRET=projects/<num>/secrets/CHATGPT_OAUTH_TOKENS   # élesben: Secret Manager
# Ha a CHATGPT_OAUTH_TOKEN_SECRET be van állítva, az élvez prioritást (Secret Manager + write-back).

# Google Gemini API (modelConfig.provider="gemini") — Google AI Studio API kulcs.
# A control plane-en a Gemini modellek legördülőből választhatók (pl. gemini-3.5-flash).
# GEMINI_API_KEY=
# GEMINI_STUB=true

# Helyi modell provider (modelConfig.provider="ollama") — pl. Gemma Ollama-n.
# Default: http://localhost:11434/v1 (Ollama OpenAI-kompatibilis API). Modell pl. gemma-local.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=

# Harness launcher (S1-S4 spike prep)
# local-wiki: lokális inline wiki runtime
# docker-local: lokális `docker run wiki-harness:local` (goose + callback, GCP nélkül)
# cloud-run-job: GCP Cloud Run Job indítás
HARNESS_LAUNCHER_MODE=local-wiki
HARNESS_DOCKER_IMAGE=wiki-harness:local
HARNESS_DOCKER_PLATFORM_HOST=host.docker.internal
HARNESS_DOCKER_PLATFORM_PORT=3000
HARNESS_CLOUD_RUN_PROJECT_ID=
HARNESS_CLOUD_RUN_LOCATION=europe-west1
HARNESS_CLOUD_RUN_JOB_NAME=
# Opcionális lokális smoke-hoz; GCP-n inkább service account metadata token.
HARNESS_CLOUD_RUN_BEARER_TOKEN=
# Cloud Run harness smoke timeout (ms)
# HARNESS_CLOUD_RUN_SMOKE_TIMEOUT_MS=300000
# GCP deploy: infra/gcp/harness-job.env.example → harness-job.env, majd npm run harness:cloud-run-deploy
# Opcionális acceptance: HARNESS_CLOUD_RUN_E2E=1 (Cloud Run Job + platform elérhető)
# Cloud Run harness completion callback: a job ezzel engedi el a dispatcher lockot.
HARNESS_CALLBACK_URL=
HARNESS_CALLBACK_TOKEN=
# Opcionális: JSON string tömbként megadott harness parancs, pl. ["goose","run","--no-session","--recipe","/recipes/wiki-answer.yaml"].
# Üresen hagyva HARNESS_MODE=goose esetén a wiki-answer recipe alapértelmezett parancs épül.
HARNESS_COMMAND_JSON=
# goose: Goose CLI + recipe; callback-only: csak completion szerződés proof
HARNESS_MODE=callback-only
HARNESS_RECIPE_PATH=/recipes/wiki-answer.yaml
# Goose provider/extension átjárók (S2/S3 spike)
# OpenAI-kompatibilis belső gateway — a Goose OPENAI_BASE_URL erre mutat
MODEL_GATEWAY_URL=http://127.0.0.1:3000/api/v1/gateway/v1
# Platform REST API — az MCP bridge a Tool Broker /api/v1/agent/tools felé proxy-z
PLATFORM_API_URL=http://127.0.0.1:3000
# Agent scoped kulcs a harness jobnak (dev: seed .seed-demo-api-key tartalma)
HARNESS_AGENT_API_KEY=
# Legacy alias — MCP bridge stdio-n fut, HTTP MCP URL opcionális jövőbeli direct transporthoz
TOOL_BROKER_MCP_URL=

# Model Gateway per-ticket guardrail (§5.4) — ticketenkénti modellhívás-plafon.
# A goose --max-turns (HARNESS_MAX_TURNS, alap 12) a tényleges konvergencia-szabályozó;
# ez a plafon a fölött ül biztonsági hálóként. Alap 30, env-ből felülírható.
GATEWAY_MAX_CALLS_PER_TICKET=30
# goose agent-loop körök maximuma (CLI --max-turns). Alap 12 — bőven elég a
# kb_search → board_write flow-hoz, és a gateway capet sem feszíti.
HARNESS_MAX_TURNS=12

# Dispatcher worker (LISTEN/NOTIFY + cron safety net)
DISPATCHER_POLL_INTERVAL_MS=30000
DISPATCHER_BATCH_LIMIT=10
# Beragadt in_progress harness lock visszavonása (ms) — default 30 perc
HARNESS_DISPATCH_TIMEOUT_MS=1800000

# Opcionális acceptance E2E — docker image + futó platform szükséges
# HARNESS_DOCKER_E2E=1
# HARNESS_DISPATCHER_E2E=1
# HARNESS_CLOUD_RUN_E2E=1

# HARNESS_EGRESS_ENFORCE=true
# HARNESS_EGRESS_PROBE_URL=https://example.com
# HARNESS_EGRESS_PROBE_TIMEOUT_MS=3000

# Fázis 2 — write-gate token aláírás (kötelező production-ben)
WRITE_GATE_SECRET=

# Dev auth fallback (when Clerk is not configured)
DEV_AUTH_USER_ID=dev-user-001
DEV_AUTH_EMAIL=dev@excellence.ai
DEV_AUTH_NAME=Dev Operator
DEV_AUTH_ROLE=operator

# Agent workspace storage (file editor — §4.2)
# FILE_EDITOR_STUB=true          # in-memory storage (dev / acceptance / Playwright E2E)
# WORKSPACE_BUCKET=platform-workspace-prod
# WORKSPACE_MAX_BYTES=524288000  # 500 MB per workspace (app-level quota)
# GCS_SERVICE_ACCOUNT_EMAIL=platform-workspace@project.iam.gserviceaccount.com
