# GCP Cloud Scheduler — a stateless dispatch-ciklus végpont (§5.7 kiegészítés) időzített
# hívása. Másold dispatch-cycle-scheduler.env néven és töltsd ki.
# Futtatás: npm run dispatcher:cloud-scheduler-deploy
#
# Ez VÁLTJA KI a wiki-dispatcher Cloud Run service-t (min-instances=1, állandó Neon-
# kapcsolat) — helyette a meglévő platform webapp (App Hosting, minInstances=0) kap egy
# rövid, időzített hívást percenként/N percenként, ami lefuttat egy dispatch-ciklust és
# visszatér. Nincs perzisztens kapcsolat, a compute a hívások között autosuspendelhet.

GCP_PROJECT_ID=your-gcp-project
GCP_REGION=europe-west4
SCHEDULER_JOB_NAME=dispatch-cycle-sweep

# A platform publikus URL-je (App Hosting) — a végpont: $PLATFORM_API_URL/api/v1/internal/dispatch-cycle
PLATFORM_API_URL=https://your-platform.example.com

# Ugyanaz az érték, mint a platform DISPATCHER_CONTROL_TOKEN secretje (Secret Manager /
# apphosting.yaml). Enélkül a végpont 401-et ad.
DISPATCHER_CONTROL_TOKEN=

# Cron ütem (5 mezős, standard cron szintaxis). Alap: 2 percenként — ennyi bőven elég a
# stale-reclaim/ütemezett task/monitor-söprés biztonsági hálóhoz, a ready ticketek zöme
# amúgy is azonnal, a keletkezésük kérésén belül dispatchelődik.
SCHEDULE="*/2 * * * *"
TIME_ZONE=Etc/UTC

# Ennyi ideig várja a választ, mielőtt sikertelennek jelöli a futást (a ciklus jellemzően
# másodperces nagyságrendű, de egy nagyobb batch-nél adjunk mozgásteret).
ATTEMPT_DEADLINE=60s
