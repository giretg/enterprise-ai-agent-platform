# GCP Cloud Scheduler — a stateless dispatch-ciklus végpont (§5.7 kiegészítés) időzített
# hívása. Másold dispatch-cycle-scheduler.env néven és töltsd ki.
# Futtatás: npm run dispatcher:cloud-scheduler-deploy
#
# #114 óta a job a DEDIKÁLT WORKER szolgáltatást hívja, nem a control-plane UI-t: a ciklus
# (stale-reclaim, ütemezett taskok, monitor-söprés, workspace-purge, channel-turn drain,
# ready ticket dispatch) így nem az interaktív oldalak konténerében fut. A végpont és a
# hitelesítés változatlan — csak a cél-URL más.

GCP_PROJECT_ID=your-gcp-project
GCP_REGION=europe-west4
SCHEDULER_JOB_NAME=dispatch-cycle-sweep

# ELSŐDLEGES CÉL: a dedikált dispatch-cycle worker Cloud Run URL-je
# (npm run dispatch-cycle:cloud-run-deploy írja ki a deploy végén).
# A hívott végpont: $DISPATCH_CYCLE_TARGET_URL/api/v1/internal/dispatch-cycle
DISPATCH_CYCLE_TARGET_URL=https://platform-dispatch-cycle-xxxxx-ew.a.run.app

# A control-plane UI (App Hosting) publikus URL-je. Ez a ROLLBACK célja:
#   npm run dispatcher:cloud-scheduler-deploy -- --rollback
# Ilyenkor a Scheduler újra az UI-t hívja (a worker érintetlen marad).
PLATFORM_API_URL=https://your-platform.example.com

# A worker alapból --no-allow-unauthenticated, ezért a Schedulernek OIDC tokent is kell
# küldenie. Ennek az SA-nak roles/run.invoker joga kell legyen a worker szolgáltatáson:
#   gcloud run services add-iam-policy-binding platform-dispatch-cycle \
#     --region=$GCP_REGION --project=$GCP_PROJECT_ID \
#     --member=serviceAccount:$SCHEDULER_OIDC_SERVICE_ACCOUNT --role=roles/run.invoker
# (Az UI-ra visszairányított rollbacknél ez elhagyható — ott a token-fejléc a kapu.)
SCHEDULER_OIDC_SERVICE_ACCOUNT=dispatch-cycle-scheduler@your-gcp-project.iam.gserviceaccount.com
# Alapból a cél base URL. Csak akkor írd felül, ha egyedi audience-t használsz.
# SCHEDULER_OIDC_AUDIENCE=

# Ugyanaz az érték, mint a CÉL szolgáltatás DISPATCHER_CONTROL_TOKEN secretje (a workeren
# Secret Managerből, az UI-n apphosting.yaml RUNTIME). Enélkül a végpont 401-et ad — és
# mivel a rollback a másik szolgáltatásra vált, MINDKÉT oldalon ugyanannak kell lennie.
DISPATCHER_CONTROL_TOKEN=

# Cron ütem (5 mezős, standard cron szintaxis). Alap: 2 percenként — ennyi bőven elég a
# stale-reclaim/ütemezett task/monitor-söprés biztonsági hálóhoz, a ready ticketek zöme
# amúgy is azonnal, a keletkezésük kérésén belül dispatchelődik.
SCHEDULE="*/2 * * * *"
TIME_ZONE=Etc/UTC

# Ennyi ideig várja a választ, mielőtt sikertelennek jelöli a futást (a ciklus jellemzően
# másodperces nagyságrendű, de egy nagyobb batch-nél adjunk mozgásteret). Legyen ≤ a worker
# REQUEST_TIMEOUT értéke, különben a Cloud Run vágja el a ciklust a Scheduler előtt.
ATTEMPT_DEADLINE=60s
