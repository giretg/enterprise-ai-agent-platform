# Cloud Scheduler configuration for the stateless dispatch cycle.
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=europe-west4
SCHEDULER_JOB_NAME=dispatch-cycle-sweep

# Dedicated Cloud Run worker URL. For rollback, temporarily set this to the
# Firebase App Hosting UI URL; the HTTP path and response contract are identical.
DISPATCH_CYCLE_TARGET_URL=https://platform-dispatch-cycle-xxxxx-ew.a.run.app

# Same value as the worker/UI DISPATCHER_CONTROL_TOKEN secret.
DISPATCHER_CONTROL_TOKEN=

# Required when the Cloud Run worker uses --no-allow-unauthenticated.
# The Scheduler caller needs roles/run.invoker on the worker service.
OIDC_SERVICE_ACCOUNT_EMAIL=
# Defaults to DISPATCH_CYCLE_TARGET_URL when empty.
OIDC_TOKEN_AUDIENCE=

SCHEDULE="*/2 * * * *"
TIME_ZONE=Etc/UTC
ATTEMPT_DEADLINE=60s
