# GCP Cloud Run dispatcher service — másold dispatcher-service.env néven és töltsd ki.
# Futtatás: npm run dispatcher:cloud-run-deploy

GCP_PROJECT_ID=your-gcp-project
GCP_REGION=europe-west4
DISPATCHER_SERVICE_NAME=wiki-dispatcher
ARTIFACT_REGISTRY_REPO=ai-platform

# Dedikált runtime SA, amin run.jobs.runWithOverrides (roles/run.developer) van a Jobon.
SERVICE_ACCOUNT=wiki-dispatcher@your-gcp-project.iam.gserviceaccount.com

# A platform publikus URL-je (App Hosting / Cloud Run service)
PLATFORM_API_URL=https://your-platform.example.com
MODEL_API_URL=
HARNESS_CALLBACK_URL=https://your-platform.example.com

# Az indítandó harness Cloud Run Job neve (npm run harness:cloud-run-deploy hozta létre)
HARNESS_CLOUD_RUN_JOB_NAME=wiki-harness
HARNESS_MODE=goose
HARNESS_RECIPE_PATH=/recipes/wiki-answer.yaml
HARNESS_EGRESS_ENFORCE=true

# DB connection Secret Manager-ben (LISTEN/NOTIFY-hoz NEM-pooler / direct endpoint!).
# A worker DIRECT_URL ?? DATABASE_URL sorrendben olvas; mindkettő ugyanerre a secretre megy.
DATABASE_URL_SECRET=dispatcher-database-url

# Opcionális: harness callback token Secret Manager-ben (a Jobnak override-on át adjuk).
# Egyezzen a platform HARNESS_CALLBACK_TOKEN értékével.
# HARNESS_CALLBACK_TOKEN_SECRET=harness-callback-token

# A goose harness agent API kulcsa Secret Manager-ben — ezzel hív vissza a platform
# Tool Broker + Gateway végpontjaira. KÖTELEZŐ goose módban (különben a Job exit(1):
# "Missing harness env for goose config: HARNESS_AGENT_API_KEY").
# HARNESS_AGENT_API_KEY_SECRET=harness-agent-api-key

# Worker hangolás
DISPATCHER_POLL_INTERVAL_MS=30000
DISPATCHER_BATCH_LIMIT=10

# Skálázás — egyetlen worker elég (idempotens lock véd a duplázás ellen).
MAX_INSTANCES=1
SERVICE_CPU=1
SERVICE_MEMORY=512Mi

# Stub broker fallback (csak dev/smoke — élesben NE)
# STUB_BROKER_FALLBACK=1

# VPC egress (opcionális — ha a DB/platform VPC-n belül van)
# VPC_CONNECTOR=projects/your-gcp-project/locations/europe-west4/connectors/dispatcher-connector
# VPC_EGRESS=private-ranges-only
