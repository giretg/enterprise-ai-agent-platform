# GCP Cloud Run harness job — másold harness-job.env néven és töltsd ki.
# Futtatás: npm run harness:cloud-run-deploy

GCP_PROJECT_ID=your-gcp-project
GCP_REGION=europe-west1
HARNESS_JOB_NAME=wiki-harness
ARTIFACT_REGISTRY_REPO=ai-platform

# A platform publikus URL-je (Cloud Run service / App Hosting)
PLATFORM_API_URL=https://your-platform.example.com
MODEL_API_URL=
HARNESS_CALLBACK_URL=https://your-platform.example.com

# Egyezzen a platform HARNESS_CALLBACK_TOKEN értékével
HARNESS_CALLBACK_TOKEN=change-me-shared-secret

# S4 deny-by-default runtime probe (VPC firewall mellett)
HARNESS_EGRESS_ENFORCE=true
HARNESS_EGRESS_PROBE_URL=https://example.com

# Stub OAuth mellett stub agent loop a harnessben (dev/smoke)
HARNESS_STUB_BROKER_FALLBACK=1

# VPC egress (ajánlott production-ben — firewall szabályokkal párosítva)
# VPC_CONNECTOR=projects/your-gcp-project/locations/europe-west1/connectors/harness-connector
# VPC_EGRESS=all-traffic

# SERVICE_ACCOUNT=wiki-harness-runner@your-gcp-project.iam.gserviceaccount.com
# TASK_TIMEOUT=30m
# JOB_CPU=1
# JOB_MEMORY=1Gi
