# GCP Cloud Run — dedikált dispatch-ciklus worker (#114).
# Másold `dispatch-cycle-service.env` néven és töltsd ki.
# Futtatás: npm run dispatch-cycle:cloud-run-deploy
#
# Ez a szolgáltatás szolgálja ki a Cloud Scheduler hívásait a control-plane UI HELYETT:
# ugyanaz a végpont (POST /api/v1/internal/dispatch-cycle), ugyanaz a `runDispatchCycle`
# mag, csak külön konténerben. Így egy nehéz ciklus nem lassítja/OOM-olja az interaktív
# oldalakat, és a worker skálázása/erőforrás-profilja az UI érintése nélkül hangolható.
#
# EZ NEM a legacy `wiki-dispatcher` (LISTEN/NOTIFY, min-instances=1) — az a
# `dispatcher-service.env.example` + `Dockerfile.dispatcher`.

GCP_PROJECT_ID=your-gcp-project
GCP_REGION=europe-west4
DISPATCH_CYCLE_SERVICE_NAME=platform-dispatch-cycle
ARTIFACT_REGISTRY_REPO=ai-platform

# Runtime service account. Kell neki:
#   - secretmanager.secretAccessor a lenti titkokhoz,
#   - run.developer a wiki-harness Jobon, ha a ciklus indít agent-futtatást
#     (HARNESS_LAUNCHER_MODE=cloud-run-job).
SERVICE_ACCOUNT=dispatch-cycle@your-gcp-project.iam.gserviceaccount.com

# --- Titkok (Secret Manager nevek) ---
# UGYANAZ az érték, mint az UI (apphosting.yaml) DISPATCHER_CONTROL_TOKEN secretje és a
# Scheduler job x-dispatcher-token fejléce — különben a célzott hívás 401-et kap.
DISPATCHER_CONTROL_TOKEN_SECRET=DISPATCHER_CONTROL_TOKEN

# UGYANAZ a Neon adatbázis, amit az UI lát (ugyanaz a tenant-adat; a database-mode a
# platform_settings táblából jön, tehát az éles/teszt váltást a worker is követi).
DATABASE_URL_SECRET=PLATFORM_DATABASE_URL
# Ha nincs megadva, a DATABASE_URL_SECRET-et használjuk DIRECT_URL-ként is.
# DIRECT_URL_SECRET=PLATFORM_DIRECT_URL

# Teszt branch (csak ha a platform database-mode-ot `test`-re tudod állítani).
# DATABASE_URL_TEST_SECRET=DATABASE_URL_TEST
# DIRECT_URL_TEST_SECRET=DIRECT_URL_TEST

# --- BOOT-KRITIKUS titkok (KÖTELEZŐ — a deploy-szkript a build előtt ellenőrzi) ---
# Ezek NEM „némán hiányzó" beállítások: a worker az UI-jal ellentétben a TELJES ciklus-gráfot
# importálja induláskor, a `resolveSecret` pedig prod alatt IMPORT-IDŐBEN dob, ha a titok
# hiányzik — a Cloud Run revízió ilyenkor el sem indul („container failed to start").
# Az ÉRTÉKÜK egyezzen az UI-éval (apphosting.yaml RUNTIME), különben a két szolgáltatás
# egymás audit-láncát / linkjeit / tokenjeit nem tudja ellenőrizni.
# Ha egy titok még nem létezik a Secret Managerben, hozd létre az UI értékével:
#   gcloud secrets create CHANNEL_LINK_TOKEN_SECRET --project=$GCP_PROJECT_ID --replication-policy=automatic
#   printf '%s' "<az UI-n használt érték>" | gcloud secrets versions add CHANNEL_LINK_TOKEN_SECRET --data-file=-
WRITE_GATE_SECRET_NAME=WRITE_GATE_SECRET
OAUTH_STATE_SECRET_NAME=OAUTH_STATE_SECRET
SANDBOX_PREVIEW_SECRET_NAME=SANDBOX_PREVIEW_SECRET
CHANNEL_LINK_TOKEN_SECRET_NAME=CHANNEL_LINK_TOKEN_SECRET
CHANNEL_IDENTITY_SECRET_NAME=CHANNEL_IDENTITY_SECRET
CHANNEL_APPROVAL_TOKEN_SECRET_NAME=CHANNEL_APPROVAL_TOKEN_SECRET
AGENT_API_KEY_LOOKUP_SECRET_NAME=AGENT_API_KEY_LOOKUP_SECRET

# A ciklus alatt futó szolgáltatások titkai. Ami itt hiányzik, az a workeren nincs meg —
# pl. modell-kulcs nélkül a monitor-eszkaláció / agent-indítás elhasal (a worker elindul,
# csak az adott lépés fut hibára).
# GEMINI_API_KEY_SECRET=GEMINI_API_KEY
# OPENROUTER_API_KEY_SECRET=OPENROUTER_API_KEY
# HARNESS_CALLBACK_TOKEN_SECRET=HARNESS_CALLBACK_TOKEN
# HARNESS_AGENT_API_KEY_SECRET=harness-agent-api-key

# --- Runtime env (nem titok) ---
# A platform publikus URL-je — a ciklusból induló harness ezen hív vissza.
PLATFORM_API_URL=https://your-platform.example.com
HARNESS_CALLBACK_URL=https://your-platform.example.com
# MODEL_GATEWAY_URL=https://your-platform.example.com/api/v1/gateway/v1
HARNESS_LAUNCHER_MODE=cloud-run-job
HARNESS_CLOUD_RUN_JOB_NAME=wiki-harness
# WORKSPACE_BUCKET=
# GCS_SERVICE_ACCOUNT_EMAIL=
DISPATCHER_BATCH_LIMIT=10
# Szabad formátumú kiegészítés (vesszővel elválasztott KEY=VALUE párok), ha a ciklusnak
# további env kell: EXTRA_ENV_VARS=FOO=1,BAR=2
# EXTRA_ENV_VARS=

# --- Erőforrás-profil (az UI App Hostingtól FÜGGETLEN) ---
# min=0: a ciklus rövid és időzített, nincs értelme állandóan égetni. Ha a hidegindítás a
# Scheduler attempt-deadline-jét feszegeti, emeld 1-re.
MIN_INSTANCES=0
MAX_INSTANCES=2
SERVICE_CPU=1
SERVICE_MEMORY=1Gi
# Egy ciklus fut egyszerre a processzben (in-flight kapu) — a párhuzamos kérés csak üres
# summary-t kapna.
SERVICE_CONCURRENCY=1
# Legyen ≥ a Scheduler ATTEMPT_DEADLINE-ja, különben a Cloud Run vágja el a ciklust.
REQUEST_TIMEOUT=300s

# VPC egress (opcionális — ha a DB/platform VPC-n belül van)
# VPC_CONNECTOR=projects/your-gcp-project/locations/europe-west4/connectors/dispatch-cycle
# VPC_EGRESS=private-ranges-only
