# Dedicated Cloud Run service for the stateless dispatch cycle.
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=europe-west4
DISPATCH_CYCLE_SERVICE_NAME=platform-dispatch-cycle

# Secret Manager secret names, not secret values.
DISPATCHER_CONTROL_TOKEN_SECRET=DISPATCHER_CONTROL_TOKEN
DATABASE_URL_SECRET=DATABASE_URL
DIRECT_URL_SECRET=DIRECT_URL

# Optional dedicated runtime service account.
SERVICE_ACCOUNT=

# Independent worker resource profile.
CPU=1
MEMORY=1Gi
MIN_INSTANCES=0
MAX_INSTANCES=3
TIMEOUT=300s
CONCURRENCY=1

# Optional comma-separated gcloud mappings.
# Example: GEMINI_API_KEY=GEMINI_API_KEY:latest,WRITE_GATE_SECRET=WRITE_GATE_SECRET:latest
EXTRA_SECRETS=
# Example: HARNESS_LAUNCHER_MODE=cloud-run-job,WORKSPACE_BUCKET=my-bucket
EXTRA_ENV_VARS=
